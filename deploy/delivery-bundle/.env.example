# libertree-delivery 통합 번들 환경 변수
# 복사: cp .env.example .env  (.env는 커밋하지 않습니다. chmod 600 .env 권장)
# 값이 비어 있으면 docker-compose.yml의 기본값을 씁니다(괄호 안).
# 비밀값(비밀번호·토큰·키)은 이 .env에만 둡니다.

# ---- 선택 오버라이드 파일 ------------------------------------------------
# 오버라이드를 켤 때만 주석을 풀고 콜론으로 이어 씁니다.
#   상태 폴더:         docker-compose.yml:docker-compose.collect-status.yml
#   호스트 runner 소켓: docker-compose.yml:docker-compose.runner-socket.yml
# COMPOSE_FILE=
# compose 프로젝트 이름 (libertree-delivery-v2). 운영 중인 libertree-delivery 로 절대 바꾸지 않음
# COMPOSE_PROJECT_NAME=

# ---- 이미지 ------------------------------------------------------------
# 빌드 이미지 이름 접두사 (libertree-delivery-v2). 운영 이미지 이름을 덮어쓰지 않도록 유지
IMAGE_PREFIX=
# 이미지 태그. 필수 (예: 20261020). 비우면 모든 compose 명령이 실패
IMAGE_TAG=

# ---- 기존 운영 PostgreSQL (이 번들은 postgres 를 띄우지 않음) ---------------
# 운영 DB 계정 (libertree). 운영 .env 의 값과 같게
POSTGRES_USER=
# 운영 DB 비밀번호. 필수. 운영 .env 의 값 그대로(DSN URL 에 들어가므로 16진수 등 URL 안전 문자만)
POSTGRES_PASSWORD=
# 운영 DB 이름 (libertree)
POSTGRES_DB=
# 운영 postgres 컨테이너 이름 = 접속 호스트명 (libertree-delivery-postgres-1)
PROD_DB_HOST=
# 운영 postgres 가 붙어 있는 기존 네트워크, external 로 참조 (libertree-delivery_default)
PROD_DB_NETWORK=

# ---- blob(PDF/텍스트 파일) ---------------------------------------------
# 운영 blob 디렉터리 절대경로(운영 be 와 같은 경로). 필수. be 읽기 전용, worker/file-worker 읽기·쓰기
BLOB_HOST_PATH=

# ---- 포트 --------------------------------------------------------------
# BE 호스트 포트, 127.0.0.1에만 바인드 (8080, 운영과 같음 → 컷오버 때 기존 be 정지 후 사용)
BE_PORT=
# FE 호스트 포트 (3000)
FE_PORT=
# FE 바인드 주소 (127.0.0.1). FE=운영자 권한(로그인 없음): 0.0.0.0 은 인증 프록시/IP 제한 뒤에서만
FE_BIND=

# ---- 인증 --------------------------------------------------------------
# 운영자 인증 방식: token | disabled (token). 운영에서는 token만 사용
DELIVERY_AUTH_MODE=
# 운영자 API 토큰(be·fe 공용, 32자 이상). 필수. openssl rand -hex 32
DELIVERY_API_TOKEN=
# FE 화면·API 전체의 Basic 인증 계정. 둘 다 필수(비우면 FE가 모든 요청을 503으로 거부)
FE_BASIC_USER=
FE_BASIC_PASS=

# ---- BE ----------------------------------------------------------------
# DB 커넥션 풀 최소 (1)
DELIVERY_DB_POOL_MIN=
# DB 커넥션 풀 최대 (10)
DELIVERY_DB_POOL_MAX=
# 집계 캐시 TTL 초 (30)
DELIVERY_AGGREGATE_CACHE_SECONDS=
# 수집기 검사 결과를 오래된 것으로 볼 시간 (48)
CRAWLER_HEALTH_STALE_HOURS=

# ---- 번역 --------------------------------------------------------------
# 외부(OpenAI 호환) 번역 엔드포인트
TRANSLATION_EXTERNAL_ENDPOINT=
# 외부 번역 모델명
TRANSLATION_EXTERNAL_MODEL=
# 외부 번역 API 키
TRANSLATION_EXTERNAL_API_KEY=
# 내부(Ollama 호환) 번역 엔드포인트 (컨테이너에서 닿는 주소)
TRANSLATION_INTERNAL_ENDPOINT=
# 내부 번역 모델명 (be·fe·worker 공용)
TRANSLATION_INTERNAL_MODEL=
# 워커 식별자 (delivery-worker-1)
TRANSLATION_WORKER_ID=

# ---- 워커 --------------------------------------------------------------
# 크롤 작업 1건 실행 시간 예산 초 (1500)
LIBERTREE_MAX_WALL_S=
# PDF 다운로드·텍스트 추출 단계별 최대 초, 10~600 (180)
FILE_STAGE_TIMEOUT_SECONDS=

# ---- ScienceON ---------------------------------------------------------
# ScienceON API 키
SCIENCEON_KEY=
# ScienceON 클라이언트 ID
SCIENCEON_CLIENT_ID=
# ScienceON 등록 MAC 주소
SCIENCEON_MAC_ADDRESS=
# 토큰 캐시 파일 경로, 컨테이너 내부 (/data/runtime/scienceon_token.json)
SCIENCEON_TOKEN_CACHE=
# 1회 작업당 처리 슬라이스 수 (4)
SCIENCEON_SLICE_BUDGET=
# 증분 수집 대상 연도 수 (2)
SCIENCEON_INCREMENTAL_YEARS=
# 증분 수집 페이지 수 (3)
SCIENCEON_INCREMENTAL_PAGES=

# ---- 사이트 검색 키 (be·worker) ----------------------------------------
# cancer.fr 카탈로그 검색 키
CANCER_FR_CATALOGUE_DES_PUBLIC_KEY=
# education.govt.nz our-work 검색 키
EDUCATION_GOVT_NZ_OUR_WORK_KEY=
# education.govt.nz 검색 키
EDUCATION_GOVT_NZ_SEARCH_KEY=
# inrae.fr 뉴스 검색 키
INRAE_FR_ACTUALITES_KEY=
# nkvts.no 검색 키
NKVTS_NO_ENGLISH_KEY=
# phfscience.nz 디지털 라이브러리 검색 키
PHFSCIENCE_NZ_DIGITAL_LIBRARY_KEY=
# phfscience.nz 뉴스·간행물 검색 키
PHFSCIENCE_NZ_NEWS_PUBLICATIONS_KEY=
# transparency.gov.au 간행물 검색 키
TRANSPARENCY_GOV_AU_PUBLICATIONS_KEY=

# ---- 수집 실행기(runner) / 사이트 수집 화면 ----------------------------
# be→runner 주소 (http://runner:8793). 바꾸지 않음
COLLECT_RUNNER_URL=
# runner 토큰 직접 지정. 비우면 COLLECT_RUNNER_HOME/.token 파일을 읽음 (권장: 비움)
COLLECT_RUNNER_TOKEN=
# runner 응답 캐시 초 (3)
COLLECT_RUNNER_CACHE_SECONDS=
# runner 상태 호스트 디렉터리, 컨테이너에도 같은 경로. 필수, .token 미리 생성 (/srv/collect-runner-v2)
COLLECT_RUNNER_HOME=
# 수집 실행 폴더 루트, 호스트=컨테이너 같은 경로. 필수 (/srv/enum-pilot-run)
COLLECT_RUNS_ROOT=
# runner 실행 uid, 위 두 디렉터리 소유자 (1000)
COLLECT_RUNNER_UID=
# runner 실행 gid (1000)
COLLECT_RUNNER_GID=
# docker 소켓 그룹 id: stat -c %g /var/run/docker.sock (999)
DOCKER_GID=
# [collect-status 오버라이드] 사이트 상태 CSV 호스트 폴더
COLLECT_STATUS_HOST_DIR=
# [runner-socket 오버라이드] 호스트 runner 의 RUNNER_SOCKET 이 있는 폴더 (예: /home/<사용자>/collect-runner/sock)
COLLECT_RUNNER_HOST_SOCKET_DIR=
# [runner-socket 오버라이드] 그 폴더 안 소켓 파일 이름 (runner.sock)
COLLECT_RUNNER_SOCKET_NAME=

# ---- 참고: 코드가 읽지만 이 번들이 전달하지 않는 변수 ---------------------
# 아래는 코드 기본값으로 동작하며 .env에 넣어도 컨테이너에 전달되지 않습니다
# (현재 운영 compose와 동일). 바꾸려면 docker-compose.yml에 명시적으로 추가.
# worker: LIBERTREE_MAX_PAGES(200) LIBERTREE_OVERLAP_PAGES(1) LIBERTREE_KNOWN_RUN(50)
#         LIBERTREE_FULL_CHECK_DAYS(30) LIBERTREE_JOB_LOG_LINES(40)
#         LIBERTREE_JOB_LOG_RETENTION_DAYS(14)
# 컴포즈가 자동 조합: LIBERTREE_PG_DSN, LIBERTREE_DB_BACKEND, LIBERTREE_BLOB_ROOT,
#         CRAWLER_HEALTH_REPORT_DIR, COLLECT_RUNNER_TOKEN_FILE(/run/collect-runner/.token),
#         COLLECT_RUNNER_SOCKET(runner-socket 오버라이드: /run/collect-runner-sock/<이름>), COLLECT_STATUS_DIR,
#         BE_URL, RUNNER_HOME, RUNNER_BIND
# 운영 스택 밖 도구 전용: AUDIT_PG_DSN, RECOVERY_PG_DSN, IMPORT_APPLY_APPROVED,
#         QWEN_CANARY_CONFIRM, LLM_ENDPOINT, LLM_API_KEY, SERVED_MODEL_NAME,
#         LIBERTREE_CATALOGUE_CSV, OPENAI_API_KEY, GEMINI_API_KEY, LLM_PROVIDER
