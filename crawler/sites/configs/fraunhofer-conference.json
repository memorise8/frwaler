{
  "site_id": "fraunhofer-conference",
  "site_name": "Fraunhofer Publica - Conference Paper",
  "base_url": "https://publica.fraunhofer.de",
  "crawl_type": "html",
  "list_page": {
    "url": "https://publica.fraunhofer.de/search",
    "params": {
      "page": "1",
      "configuration": "researchoutputs",
      "query": "",
      "f.oavisible": "Open Access,equals",
      "spc.page": "1",
      "f.types": "Conference Paper,equals"
    },
    "pagination": {
      "type": "query_param",
      "param": "spc.page",
      "start": 1,
      "step": 1
    },
    "selectors": {
      "item_container": "li.ds-artifact-item",
      "item_link": "a",
      "item_link_attr": "href",
      "title": "h4.artifact-title a",
      "date": "span.date",
      "category": null
    }
  },
  "detail_page": {
    "selectors": {
      "title": "h2",
      "abstract": "div.simple-item-view-description",
      "authors": "span.author",
      "date": "span.date",
      "pdf_link": "a[href*='bitstream']",
      "keywords": null,
      "department": null,
      "doi": "span.doi",
      "auto_detect_files": true
    }
  },
  "options": {
    "delay": 2.0,
    "encoding": null,
    "verify_ssl": true,
    "id_regex": null,
    "fetch_method": "browser",
    "timeout": 30
  }
}