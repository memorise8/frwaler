{
  "site_id": "gsi-ie",
  "site_name": "Geological Survey Ireland — Publications",
  "base_url": "https://www.gsi.ie",
  "crawl_type": "html",
  "list_page": {
    "url": "https://www.gsi.ie/publications/",
    "pagination": {
      "type": "none"
    },
    "selectors": {
      "item_container": ".publication-item",
      "item_link": ".publication-content h3 a[href]",
      "date": ".publication-content em",
      "date_format": "Published %d %B %Y"
    }
  },
  "detail_page": {
    "selectors": {
      "title": "h1",
      "abstract": ".publication-content",
      "pdf_link": ".publication-content a[href$=\".pdf\"]"
    }
  },
  "options": {
    "delay": 1.5
  }
}
