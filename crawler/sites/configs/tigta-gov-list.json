{
  "site_id": "tigta-gov-list",
  "site_name": "TIGTA Reports",
  "base_url": "https://www.tigta.gov",
  "crawl_type": "html",
  "list_page": {
    "url": "https://www.tigta.gov/reports/list",
    "pagination": {
      "type": "query_param",
      "param": "page",
      "start": 0,
      "step": 1
    },
    "selectors": {
      "item_container": "h3",
      "item_link": "a",
      "title": "a",
      "date": null
    }
  },
  "detail_page": {
    "selectors": {
      "title": "h1",
      "abstract": "div.field--body",
      "date": "time.datetime",
      "pdf_link": "a[href$='.pdf']",
      "auto_detect_files": true
    }
  },
  "options": {
    "delay": 1.5,
    "fetch_method": "browser"
  }
}