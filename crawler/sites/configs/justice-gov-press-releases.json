{
  "site_id": "justice-gov-press-releases",
  "site_name": "DOJ Press Releases",
  "base_url": "https://www.justice.gov",
  "crawl_type": "html",
  "list_page": {
    "url": "https://www.justice.gov/news/press-releases",
    "pagination": {"type": "query_param", "param": "page", "start": 0, "step": 1},
    "selectors": {
      "item_container": "div.views-row",
      "item_link": "a",
      "title": "a",
      "date": null
    }
  },
  "detail_page": {
    "selectors": {
      "title": "h1",
      "abstract": "div.node__content",
      "date": "time",
      "pdf_link": "a[href$='.pdf']"
    }
  },
  "options": {"delay": 1.5, "fetch_method": "browser"}
}
