{
  "site_id": "va-gov-report",
  "site_name": "va.gov - Report.Asp",
  "base_url": "https://www.va.gov",
  "crawl_type": "single-page",
  "list_page": {
    "url": "https://www.va.gov/vetdata/report.asp",
    "selectors": {
      "link": "a[href$='.pdf'], a[href$='.xlsx']",
      "link_attr": "href",
      "category_heading": "h2"
    }
  },
  "options": {
    "delay": 1.5,
    "encoding": null,
    "verify_ssl": true,
    "id_regex": null
  },
  "detail_page": {
    "selectors": {
      "auto_detect_files": true
    }
  }
}