# OpenAI API key used by AutoAddAgent (GPT API path) and Codex CLI (Tier 2 autonomous crawler generation).
# Get it from https://platform.openai.com/api-keys. Requires access to the `gpt-5.4` model.
OPENAI_API_KEY=

# Optional: alternative LLM provider for Smart Finder's AI fallback.
# GEMINI_API_KEY=

# Default LLM provider for Smart Finder. 'gpt' | 'gemini'. Default: gpt.
LLM_PROVIDER=gpt
