# OpenAI API key used by AutoAddAgent (GPT API path) and Codex CLI (Tier 2 autonomous crawler generation).
# Get it from https://platform.openai.com/api-keys. Requires access to the `gpt-5.4` model.
OPENAI_API_KEY=

# Optional: alternative LLM provider for Smart Finder's AI fallback.
# GEMINI_API_KEY=

# Default LLM provider for Smart Finder. 'gpt' | 'gemini'. Default: gpt.
LLM_PROVIDER=gpt

# Public read-only search API keys (per-site). Values in crawler/.env (gitignored).
CANCER_FR_CATALOGUE_DES_PUBLIC_KEY=
EDUCATION_GOVT_NZ_OUR_WORK_KEY=
EDUCATION_GOVT_NZ_SEARCH_KEY=
INRAE_FR_ACTUALITES_KEY=
NKVTS_NO_ENGLISH_KEY=
PHFSCIENCE_NZ_DIGITAL_LIBRARY_KEY=
PHFSCIENCE_NZ_NEWS_PUBLICATIONS_KEY=
TRANSPARENCY_GOV_AU_PUBLICATIONS_KEY=
