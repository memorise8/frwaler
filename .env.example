# Frwaler — environment variables for the PRO server
# Copy this to ".env" and fill in real values. Never commit .env.

# Required: OpenAI API key (used for chat /pro/api/chat and summarize)
PRO_OPENAI_API_KEY=sk-replace-me

# Optional: Gemini API key (used by datasheet PDF parser fallback)
GEMINI_KEY=

# Optional: override default settings
# PRO_LICENSE_DB_PATH=./data/licenses.db
# PRO_PRODUCTS_DB_PATH=./data/products.db
# PRO_SCREENING_DB_PATH=./data/screening.db
# PRO_JWT_SECRET=change-me-in-production
# PRO_ADMIN_PASSWORD=admin1234
# PRO_ALLOWED_ORIGINS=https://your-frontend.example.com
