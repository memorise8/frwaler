# Admin gate for the finolaw dashboard.
# Browser prompts for these via HTTP Basic Auth on every request path.
# Choose strong values. Leave ADMIN_USER/ADMIN_PASSWORD BOTH empty to disable auth (local dev only — NOT for production).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional: restrict which paths require auth. Comma-separated prefixes.
# Default: all paths except Next.js internals (/_next/*) and static assets.
# AUTH_PROTECTED_PATHS=
