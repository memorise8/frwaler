# Collect runner (deploy/collect-runner/runner.py) for the delivery compose
# "runner" profile. It launches crawls through deploy/enum-pilot/run-pilot.sh,
# which drives the HOST docker daemon, so the image carries the docker CLI and
# the service mounts /var/run/docker.sock (host-root-equivalent; see the
# SECURITY note on the runner service in docker-compose.yml).
#
# /opt/frwaler-src is the source tree run-pilot.sh builds the enum-pilot image
# from (register plans with --src /opt/frwaler-src). It is the same revision as
# this image, so rebuild the runner image to pick up crawler changes.
FROM docker:27.3.1-cli AS dockercli

FROM python:3.12-slim
# Runs as an arbitrary non-root uid (compose `user:`), which has no passwd
# entry and no home: point HOME and the docker CLI config at /tmp. Everything
# else it writes lives under RUNNER_HOME and the runs root (host dirs owned by
# that uid).
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp DOCKER_CONFIG=/tmp/.docker
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# run-pilot.sh plan validation (runnerctl register) imports crawler.enumeration.plan
# with this interpreter; install the same runtime deps the crawler image uses.
COPY delivery/requirements.txt /opt/frwaler-src/delivery/requirements.txt
COPY delivery/vendor/crawler-runtime-requirements.txt /opt/frwaler-src/delivery/vendor/crawler-runtime-requirements.txt
RUN pip install --no-cache-dir -r /opt/frwaler-src/delivery/vendor/crawler-runtime-requirements.txt
COPY crawler /opt/frwaler-src/crawler
COPY delivery /opt/frwaler-src/delivery
COPY deploy/enum-pilot /opt/frwaler-src/deploy/enum-pilot
COPY deploy/collect-runner/runner.py deploy/collect-runner/runnerctl /opt/collect-runner/
COPY delivery/collect-runner.config.json /opt/collect-runner/config.container.json
# runnerctl sets RUNNER_HOME to its own directory; inside the container the
# state lives on the runner-state volume instead, so wrap it.
RUN printf '#!/bin/sh\nif [ "$1" = "ensure" ]; then exec python3 /opt/collect-runner/runner.py ensure; fi\nexec python3 /opt/collect-runner/runner.py ctl "$@"\n' > /usr/local/bin/runnerctl \
    && chmod 0755 /usr/local/bin/runnerctl /opt/collect-runner/runner.py \
    && rm /opt/collect-runner/runnerctl
EXPOSE 8793
# Nothing here needs root at runtime: /opt is read-only image content, the
# socket is reached through group_add. RUNNER_HOME comes from compose
# (identical host/container path, see docker-compose.yml).
USER 1000:1000
CMD ["sh", "-c", "mkdir -p \"$RUNNER_HOME/units\" && { [ -f \"$RUNNER_HOME/config.json\" ] || cp /opt/collect-runner/config.container.json \"$RUNNER_HOME/config.json\"; } && exec python3 /opt/collect-runner/runner.py serve"]
