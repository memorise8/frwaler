# Postgres
POSTGRES_USER=libertree
POSTGRES_PASSWORD=
POSTGRES_DB=libertree
# LIBERTREE_PG_DSN은 여기서 직접 설정하지 않습니다 — docker-compose.yml이
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB로부터 자동 조합합니다
# (단일 소스: 비밀번호는 오직 POSTGRES_PASSWORD 하나로 관리).
# 크롤러 백엔드 (납품 시스템은 postgres 고정)
LIBERTREE_DB_BACKEND=postgres
# 블롭(PDF) 볼륨 마운트 경로 (컨테이너 내부)
LIBERTREE_BLOB_ROOT=/data/blob
# be 가 읽을 블롭 소스(호스트). 비워두면 named volume `blob` — 납품 기본값(빈 시작).
# 기존 블롭 트리를 실데이터로 열람하려면 호스트 경로를 지정한다(읽기 전용 마운트):
#   BE_BLOB_SOURCE=../libertree
BE_BLOB_SOURCE=
# BE 노출 포트(호스트)
BE_PORT=8080
