# Postgres
POSTGRES_USER=libertree
POSTGRES_PASSWORD=
POSTGRES_DB=libertree
# LIBERTREE_PG_DSN은 여기서 직접 설정하지 않습니다 — docker-compose.yml이
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB로부터 자동 조합합니다
# (단일 소스: 비밀번호는 오직 POSTGRES_PASSWORD 하나로 관리).
# 크롤러 백엔드 (납품 시스템은 postgres 고정)
LIBERTREE_DB_BACKEND=postgres
# 블롭(PDF) 볼륨 마운트 경로 (컨테이너 내부)
LIBERTREE_BLOB_ROOT=/data/blob
# BE 노출 포트(호스트)
BE_PORT=8080
# FE 노출 포트(호스트)
FE_PORT=3000
DELIVERY_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
# 실제 blob 연결 시 docker-compose.blob.yml과 함께 사용할 검증된 절대경로
# BLOB_HOST_PATH=/srv/libertree/blob

# 번역 Provider — 설정하지 않으면 해당 Provider 작업은 안전하게 실패합니다.
# 외부 API(OpenAI 호환). 실제 키는 .env에만 두고 커밋하지 않습니다.
TRANSLATION_EXTERNAL_ENDPOINT=
TRANSLATION_EXTERNAL_MODEL=
TRANSLATION_EXTERNAL_API_KEY=
# 내부 Ollama 호환 endpoint. 컨테이너에서 접근 가능한 주소를 사용합니다.
TRANSLATION_INTERNAL_ENDPOINT=
TRANSLATION_INTERNAL_MODEL=
