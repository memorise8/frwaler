FROM node:22-alpine AS dependencies
WORKDIR /app/delivery/fe
COPY delivery/fe/package.json delivery/fe/package-lock.json ./
RUN npm ci

FROM dependencies AS build
COPY delivery/fe/ ./
RUN npm run build

FROM node:22-alpine AS production-dependencies
WORKDIR /app/delivery/fe
COPY delivery/fe/package.json delivery/fe/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS runtime
WORKDIR /app/delivery/fe
ENV NODE_ENV=production

COPY --from=production-dependencies /app/delivery/fe/node_modules ./node_modules
COPY --from=build /app/delivery/fe/.next ./.next
COPY delivery/fe/package.json delivery/fe/package-lock.json ./

# The current frontend reads the audited crawler catalogue and taxonomy at
# request time. Keep only those inputs in the runtime image, at the same paths
# supported by crawler-health.ts.
COPY scripts/audit/crawler_status_final.csv /app/scripts/audit/crawler_status_final.csv
COPY scripts/audit/capacity_final.csv /app/scripts/audit/capacity_final.csv
COPY libertree-app/src/lib/categories.ts /app/libertree-app/src/lib/categories.ts
COPY libertree-app/src/lib/doc-type-map.generated.ts /app/libertree-app/src/lib/doc-type-map.generated.ts

EXPOSE 3002
CMD ["npm", "run", "start"]
