ode-full\">\n<div class=\"node__content\">\n<div class=\"layout-sidebar layout-sidebar--\" data-sticky-container=\"\">\n<div class=\"layout-sidebar__sidebar\">\n<div class=\"field field--name-extra-field-node-published-on field--type-extra-field field--label-hidden field__item\"><p>Published on 25 September 2026</p>\n</div>\n<div class=\"field field--name-extra-field-news-enhanced-category-list field--type-extra-field field--label-hidden field__items\">\n<div class=\"field__item\"><div class=\"taxonomy-term vocabulary-news-type\" id=\"taxonomy-term-4825\">\n<div class=\"content\">\n<a class=\"news-type-link\" href=\"/en/press\">\n<div class=\"news-type-link__picture\"><article class=\"media media--type-image-global media--view-mode-1-1-list-small\">\n<div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\"> \n</div>\n</article>\n</div>\n<div class=\"news-type-link__name\">Press release</div>\n</a>\n</div>\n</div>\n</div>\n<div class=\"field__item\"><div class=\"taxonomy-term vocabulary-news-type\" id=\"taxonomy-term-4822\">\n<div class=\"content\">\n<a class=\"news-type-link\" href=\"/en/news?f%5B0%5D=type%3A4822\">\n<div class=\"news-type-link__picture\"><article class=\"media media--type-image-global media--view-mode-1-1-list-small\">\n<div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\"> \n</div>\n</article>\n</div>\n<div class=\"news-type-link__name\">Collège de France</div>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"layout-sidebar__main\"><div class=\"content-header content-header--news\">\n<div class=\"content-header__container\">\n<div class=\"content-header__share\">\n<div class=\"mini-dropdown mini-dropdown--icon mini-dropdown--share\">\n<button aria-expanded=\"false\" aria-haspopup=\"true\" class=\"mini-dropdown__btn js-dropdown-btn\" type=\"button\">\n\n\n        Share\n          \n</button>\n<ul aria-hidden=\"true\" class=\"mini-dropdown__list js-dropdown-content\">\n<li class=\"mini-dropdown__item js-social-item\"><a aria-label=\"Share to Facebook\" class=\"facebook\" href=\"https://www.facebook.com/sharer/sharer.php?u=https%3A//www.college-de-france.fr/en/news/prix-du-college-de-france-2026&amp;title=Prix%20du%20Coll%C3%A8ge%20de%20France%202026\" rel=\"noopener\" target=\"_blank\">Facebook</a></li>\n<li class=\"mini-dropdown__item js-social-item\"><a aria-label=\"Share to LinkedIn\" class=\"linkedin\" href=\"https://www.linkedin.com/shareArticle?url=https%3A//www.college-de-france.fr/en/news/prix-du-college-de-france-2026&amp;text=Prix%20du%20Coll%C3%A8ge%20de%20France%202026\" rel=\"noopener\" target=\"_blank\">LinkedIn</a></li>\n<li class=\"mini-dropdown__item js-social-item\"><a aria-label=\"Share to Bluesky\" class=\"bluesky\" href=\"https://bsky.app/intent/compose?url=https%3A//www.college-de-france.fr/en/news/prix-du-college-de-france-2026&amp;text=Prix%20du%20Coll%C3%A8ge%20de%20France%202026\" rel=\"noopener\" target=\"_blank\">Bluesky</a></li>\n<li class=\"mini-dropdown__item js-social-item\"><a aria-label=\"Share to Threads\" class=\"threads\" href=\"https://www.threads.net/intent/post?url=https%3A//www.college-de-france.fr/en/news/prix-du-college-de-france-2026&amp;text=Prix%20du%20Coll%C3%A8ge%20de%20France%202026\" rel=\"noopener\" target=\"_blank\">Threads</a></li>\n<li class=\"mini-dropdown__item js-social-item\"><button aria-label=\"Copy current url to clipboard\" class=\"js-copy js-copy-no-params copy\" rel=\"noopener\" target=\"_blank\" type=\"button\">Copy url</button></li>\n<li class=\"mini-dropdown__item js-social-item\"><a class=\"rss-link\" href=\"/en/news.xml\" rel=\"noopener\" target=\"_blank\">News RSS</a></li>\n</ul>\n</div>\n</div>\n<div class=\"content-header__text\">\n<div class=\"content-header__suptitle\">\n<div class=\"field field--name-type field--type-entity-reference field--label-hidden field__item\">News</div>\n</div>\n<h1 class=\"content-header__title\">\n<div class=\"clearfix text-formatted field field--name-news-title field--type-text-long field--label-hidden field__item\">Prix du Collège de France 2026</div>\n</h1>\n</div>\n</div>\n</div>\n<div class=\"field field--name-news-body field--type-entity-reference-revisions field--label-hidden field__items\">\n<div class=\"paragraph paragraph--type--media-collection paragraph--view-mode--default\">\n<div class=\"media-figure js-media-figure media-figure--type-image-portrait\">\n<figure aria-label=\"Christophe Botella.\" class=\"media-figure__media\" role=\"figure\">\n<article class=\"media media--type-image-portrait media--view-mode-paragraph-media\">\n<div class=\"field field--name-field-media-image field--type-image field--label-hidden field__item\"> <a href=\"/sites/default/files/media/portrait/2026-09/christophe-botella_1.jpg\" target=\"_blank\"> \n</a>\n</div>\n</article>\n<figcaption class=\"media-figure__caption\">\n<span class=\"media-figure__legend\">Christophe Botella.</span>\n</figcaption>\n</figure>\n</div>\n</div>\n<div class=\"paragraph paragraph--type--rich-text paragraph--view-mode--default\">\n<div class=\"read-more\">\n<div>\n<div class=\"clearfix text-formatted field field--name-text-content field--type-text-long field--label-hidden field__item\"><p>Since 2022, the Collège de France Award for Young Researchers has recognized a young scientist for the excellence of their career and the innovative nature of their contributions to public research.</p><p>The prize includes a cash award of 20,000 euros and an opportunity to present their research to the Collège de France audience.</p><p>In keeping with the multidisciplinary spirit of the Collège de France, this award alternates annually between a laureate in the fields of mathematical, computer, experimental, and natural sciences, and a laureate in the fields of literature, the humanities, and the social sciences. Candidates must have defended their dissertation within the past seven years and be employed at a public research laboratory in France.</p><p>In 2026, the Collège de France Award was awarded to <a data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"18c416bd-7d4a-4e5c-8eaa-9d2a0b827cd8\" href=\"/en/person/christophe-botella\" title=\"Christophe Botella\"> <strong>Christophe Botella</strong> </a>, a researcher in statistical ecology, on the theme “Mathematical Sciences for the Planet” (Mathematics and Computer Science).</p><p>The 2026 jury consisted of <a data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"f28c1cdc-76bd-45b8-a152-58b26d856b2c\" href=\"/en/chair/nalini-anantharaman-spectral-geometry-statutory-chair\" title=\"Nalini Anantharaman, chair Spectral Geometry\">Nalini Anantharaman</a> (co-chair, Collège de France); <a data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"213dcb4d-a79d-4fea-b1b9-9ae8dad03e80\" href=\"/en/chair/xavier-leroy-software-science-statutory-chair\" title=\"Xavier Leroy, chair Software Science\">Xavier Leroy</a> (co-chair, Collège de France); <a data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"c71bc67b-d8ed-4160-88b0-0d7811997155\" href=\"/en/chair/edouard-bard-climate-and-ocean-evolution-statutory-chair\" title=\"Edouard Bard, chair Climate and Ocean Evolution\">Edouard Bard</a> (Collège de France); <a data-entity-substitution=\"canonical\" data-entity-type=\"node\" data-entity-uuid=\"e6d4a662-0850-4dd0-ae25-ab03916be1d9\" href=\"/en/chair/laure-saint-raymond-mathematical-models-in-fluid-mechanics-statutory-chair\" title=\"Laure Saint-Raymond, chair Mathematical Models in Fluid Mechanics\">Laure Saint-Raymond</a> (Collège de France); and Nigel Gilles Yoccoz (Arctic University of Norway).</p></div>\n</div>\n</div>\n</div>\n<div class=\"has-background-color paragraph paragraph--type--section paragraph--view-mode--default\">\n<div class=\"paragraph-section paragraph-section--above paragraph-section--color-sand\">\n<div class=\"paragraph-section__title-container\">\n</div>\n<div class=\"paragraph-section__content\">\n<div class=\"paragraph paragraph--type--rich-text paragraph--view-mode--default\">\n<div class=\"read-more\">\n<div>\n<div class=\"clearfix text-formatted field field--name-text-content field--type-text-long field--label-hidden field__item\"><p> <strong>Christophe Botella will give a lecture open to the public at the Collège de France on his research topics on November 26, 2026, at 6:00 p.m.</strong> </p></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"paragraph paragraph--type--elements-group paragraph--view-mode--default\">\n<div class=\"elements-group\">\n<h3 class=\"elements-group__title\">\n<div class=\"field field--name-elements-title field--type-string field--label-hidden field__item\">Documents et médias</div>\n</h3>\n<ul class=\"elements-group__list\">\n<li class=\"elements-group__item\">\n<div class=\"field field--name-elements-group field--type-entity-reference-revisions field--label-hidden field__items\">\n<div class=\"paragraph paragraph--type--document-embed paragraph--view-mode--default\">\n<a class=\"link link--document\" href=\"https://www.college-de-france.fr/sites/default/files/media/document/2026-09/cp-prix-du-college-de-france-2026.pdf\" rel=\"noopener\" target=\"_blank\" title=\"Download the press release - pdf (436.17 KB) (opens a new window)\">\n\n<div class=\"link__content\">\n<div class=\"link__title\">Download the press release</div>\n<div class=\"link__info\">pdf (436.17 KB)</div>\n</div>\n</a>\n</div>\n</div>\n</li>\n<li class=\"elements-group__item\">\n<div class=\"field field--name-elements-group field--type-entity-reference-revisions field--label-hidden field__items\">\n<div class=\"paragraph paragraph--type--link paragraph--view-mode--default\">\n<div class=\"field field--name-link field--type-link field--label-hidden field__item\">\n<a class=\"link link--internal\" href=\"/en/award/college-de-france-award\">\n