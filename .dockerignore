# Build context excludes — keep images small and reproducible.

# VCS
.git
.gitignore

# Local data (mounted as a volume at runtime)
data/
logs/
*.db
*.db-shm
*.db-wal
*.db.bak-*

# Node / Next build artifacts
finolaw/node_modules/
finolaw/.next/
finolaw/out/
node_modules/
# Recursive rules: catches these dirs at any depth (e.g. delivery/fe/),
# so host-installed deps/build output never leak into an image build
# context and clobber a fresh `npm ci` inside the Dockerfile.
**/node_modules/
**/.next/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Env files (keys go in via runtime env, not build context)
.env
.env.*
!.env.example
crawler/.env
crawler/.env.*
!crawler/.env.example

# Test outputs / planning
.omc/
report.docx
docs/프로젝트계획서.md
