{
  "version": 1,
  "sites": {
    "repo-lib-duth-gr-jspui": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://repo.lib.duth.gr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": ["html"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://repo.lib.duth.gr/jspui/browse",
        "params": {"type": "title", "sort_by": "3", "order": "DESC", "rpp": "20", "etal": "-1"},
        "page_param": "offset",
        "page_mode": "offset",
        "page_size": 20,
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url",
                   "listing_marker": "#content table.table, #content .service-wrapper-row h1"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
