{
  "version": 1,
  "sites": {
    "geoportal-statistics-gov-uk-search": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://geoportal.statistics.gov.uk",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": ["json"],
        "detail_method": "_enumeration_detail",
        "detail_args": ["json", "item"],
        "paper_method": "_enumeration_paper",
        "paper_args": ["item", "detail"]
      },
      "listing": {
        "url": "https://geoportal.statistics.gov.uk/api/search/v1/collections/document/items",
        "params": {"limit": "20", "sortBy": "-properties.modified"},
        "page_param": "startindex",
        "page_mode": "offset",
        "page_size": 20,
        "offset_base": 1,
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url"},
        "total": {"type": "json", "path": "numberMatched"}
      },
      "last_page": {"overlap_pages": 1},
      "max_consecutive_contract_failures": 30,
      "max_contract_failure_ratio": 0.5
    }
  }
}
