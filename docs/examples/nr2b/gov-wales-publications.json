{
  "version": 1,
  "sites": {
    "gov-wales-publications": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.gov.wales",
      "adapter": {
        "type": "crawler",
        "list_method": "_parse_list_page",
        "list_args": ["html"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://www.gov.wales/publications",
        "page_param": "page",
        "start_page": 0,
        "parser": {"type": "adapter", "key_field": "url", "url_field": "url",
                   "title_field": "title", "listing_marker": ".views-element-container"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
