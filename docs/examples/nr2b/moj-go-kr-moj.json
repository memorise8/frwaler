{
  "version": 1,
  "sites": {
    "moj-go-kr-moj": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.moj.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": ["html", "url"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://www.moj.go.kr/moj/221/subview.do",
        "page_param": "page",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url",
                   "title_field": "title", "date_field": "listed_date",
                   "listing_marker": "table.artclTable"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
