{
  "version": 1,
  "sites": {
    "salute-gov-it-new": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.salute.gov.it/new",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": ["json"],
        "list_returns_paper": true
      },
      "listing": {
        "url": "https://www.salute.gov.it/new/page-data/it/sezione/pubblicazioni/page-data.json",
        "page_param": "page",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url",
                   "title_field": "title", "date_field": "published_date"}
      },
      "last_page": {"overlap_pages": 1, "check_unparameterized_first_page": false}
    }
  }
}
