{
  "version": 1,
  "sites": {
    "kostat-go-kr-boardes": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://mods.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": ["html", "url"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://mods.go.kr/board.es",
        "params": {"mid": "a10403010000", "bid": "1401"},
        "page_param": "nPage",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "list_no", "url_field": "url",
                   "listing_marker": "div.board_list_01"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
