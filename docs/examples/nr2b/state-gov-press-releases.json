{
  "version": 1,
  "sites": {
    "state-gov-press-releases": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.state.gov",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": ["json"],
        "list_returns_paper": true
      },
      "listing": {
        "url": "https://www.state.gov/wp-json/wp/v2/state_press_release",
        "params": {"per_page": "20", "_fields": "id,slug,title,date,modified,link,content,excerpt,acf,class_list"},
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [{"status": 400, "json_code": "rest_post_invalid_page_number"}],
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url",
                   "title_field": "title", "date_field": "published_date"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
