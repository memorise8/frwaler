{
  "version": 1,
  "sites": {
    "data-statistik-gv-at-web": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://data.statistik.gv.at",
      "adapter": {
        "type": "crawler",
        "list_method": "_parse_catalog_items",
        "list_args": ["html", "url"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://data.statistik.gv.at/web/catalog.jsp",
        "page_param": "page",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "url", "url_field": "json_url",
                   "title_field": "title", "date_field": "listed_date_raw"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
