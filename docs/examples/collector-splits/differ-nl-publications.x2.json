{
  "version": 1,
  "sites": {
    "differ-nl-publications": {
      "strategy": "last_page_backward",
      "base_url": "https://www.differ.nl",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "first_html",
          "item"
        ],
        "second_step": {
          "use": "detail_page",
          "selector": ".bibcite-reference table tr:has(> td:first-child:-soup-contains(\"URL\")) > td:nth-of-type(2) a[href]",
          "attr": "href",
          "required": false,
          "allow_hosts": [
            "research.tue.nl"
          ]
        }
      },
      "listing": {
        "url": "https://www.differ.nl/publications?author=&year=&type=thesis&combine=",
        "page_param": "page",
        "start_page": 0,
        "page_size": 25,
        "parser": {
          "type": "adapter",
          "url_field": "detail_url",
          "key_field": "external_id",
          "title_field": "title",
          "date_field": "published_date",
          "listing_marker": ".view-differ-repository"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}