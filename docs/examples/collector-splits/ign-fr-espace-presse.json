{
  "version": 1,
  "sites": {
    "ign-fr-espace-presse": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "strategy": "date_range_split",
      "base_url": "https://www.ign.fr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.ign.fr/{segment}",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url"
        }
      },
      "segments": {
        "mode": "explicit",
        "items": [
          {"key": "espace-presse"},
          {"key": "espace-presse/communiques-de-presse-archives"}
        ],
        "allow_overlap": true
      }
    }
  }
}
