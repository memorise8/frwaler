{
  "version": 1,
  "sites": {
    "fhi-no-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.fhi.no",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "html"
        ]
      },
      "listing": {
        "url": "https://www.fhi.no/api/search",
        "params": {
          "type": "con-32/cat-750",
          "lang": "en",
          "sort": "1",
          "pageSize": 25
        },
        "page_param": "page",
        "start_page": 1,
        "total": {
          "type": "json",
          "path": "totalMatching"
        },
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "id",
          "date_field": "dateCreated",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
