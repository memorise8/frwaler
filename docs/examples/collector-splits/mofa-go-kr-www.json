{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "mofa-go-kr-www": {
   "strategy": "last_page_backward",
   "base_url": "https://www.mofa.go.kr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.mofa.go.kr/www/brd/m_4076/list.do",
    "params": {
     "page": 1,
     "srchFr": "",
     "srchTo": "",
     "srchWord": "",
     "srchTp": "",
     "multi_itm_seq": "0",
     "itm_seq_1": "0",
     "itm_seq_2": "0",
     "company_cd": "",
     "company_nm": ""
    },
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "seq",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": "tbody"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}