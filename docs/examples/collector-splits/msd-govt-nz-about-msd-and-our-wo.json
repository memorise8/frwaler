{
  "version": 1,
  "sites": {
    "msd-govt-nz-about-msd-and-our-wo": {
      "strategy": "last_page_backward",
      "base_url": "https://www.msd.govt.nz",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.msd.govt.nz/about-msd-and-our-work/publications-resources/regulatory-impact-statements/index.html",
        "page_param": "page",
        "start_page": 1,
        "page_size": 60,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "title_field": "title",
          "listing_marker": "div.block"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}