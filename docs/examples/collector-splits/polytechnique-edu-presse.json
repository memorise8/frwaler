{
  "version": 1,
  "sites": {
    "polytechnique-edu-presse": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.polytechnique.edu",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.polytechnique.edu/presse/communiques-et-dossiers-de-presse",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "key_field": "url",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "section.resultat-communiques"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}