{
  "version": 1,
  "sites": {
    "cnipa-gov-cn-col": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.cnipa.gov.cn",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          {
            "source": "query",
            "path": [
              "page"
            ],
            "type": "int"
          }
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.cnipa.gov.cn/module/web/jpage/dataproxy.jsp?webid=1&path=https://www.cnipa.gov.cn/&columnid=89&unitid=669&webname=%E5%9B%BD%E5%AE%B6%E7%9F%A5%E8%AF%86%E4%BA%A7%E6%9D%83%E5%B1%80&permissiontype=0",
        "params": {
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "article_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "datastore"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": false
      }
    }
  }
}