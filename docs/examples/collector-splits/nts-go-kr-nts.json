{
  "version": 1,
  "sites": {
    "nts-go-kr-nts": {
      "strategy": "last_page_backward",
      "base_url": "https://www.nts.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "first_html",
          "item"
        ],
        "second_step": {
          "use": "detail_page",
          "url_template": "https://www.nts.go.kr/nts/na/ntt/selectNttFileList.do?nttSn={item:ntt_sn}&bbsId=1034&mi=2210",
          "required": true
        }
      },
      "listing": {
        "url": "https://www.nts.go.kr/nts/na/ntt/selectNttList.do",
        "params": {
          "mi": "2210",
          "bbsId": "1034"
        },
        "page_param": "currPage",
        "start_page": 1,
        "page_size": 10,
        "parser": {
          "type": "adapter",
          "key_field": "ntt_sn",
          "url_field": "detail_url",
          "title_field": "title",
          "listing_marker": "tbody"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
