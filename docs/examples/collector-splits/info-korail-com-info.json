{
  "version": 1,
  "sites": {
    "info-korail-com-info": {
      "strategy": "last_page_backward",
      "base_url": "https://info.korail.com",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://info.korail.com/info/selectBbsNttList.do",
        "params": {
          "bbsNo": "199",
          "key": "911",
          "searchCtgry": "",
          "searchCnd": "all",
          "searchKrwd": "",
          "integrDeptCode": ""
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "ntt_no",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "table"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
