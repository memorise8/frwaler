{
  "version": 1,
  "sites": {
    "kommunekredit-com-about-us": {
      "strategy": "last_page_backward",
      "base_url": "https://www.kommunekredit.com",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "resp",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.kommunekredit.com/about-us/reports-numbers-and-publications/reports/",
        "page_param": "page",
        "start_page": 1,
        "page_size": 30,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "key_field": "external_id",
          "title_field": "title",
          "listing_marker": "script[type='application/json']"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}