{
  "version": 1,
  "sites": {
    "ntp-niehs-nih-gov-publications": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://ntp.niehs.nih.gov",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item",
          "url"
        ]
      },
      "listing": {
        "url": "https://ntp.niehs.nih.gov/publications/reports",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "title_field": "title",
          "date_field": "listed_date",
          "listing_marker": "table#datatable"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
