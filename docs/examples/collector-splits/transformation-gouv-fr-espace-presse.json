{
 "version": 1,
 "sites": {
  "transformation-gouv-fr-espace-presse": {
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "strategy": "last_page_backward",
   "base_url": "https://www.transformation.gouv.fr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_detail",
    "detail_args": [
     "pdf_text",
     "item"
    ],
    "pdf_text": {
     "args": [],
     "timeout_s": 30,
     "min_bytes": 0
    }
   },
   "listing": {
    "url": "https://www.transformation.gouv.fr/espace-presse",
    "params": {
     "field_type_presse_target_id[17]": "17"
    },
    "page_param": "page",
    "start_page": 0,
    "page_size": 10,
    "parser": {
     "type": "adapter",
     "key_field": "original_filename",
     "url_field": "pdf_url",
     "date_field": "published_date",
     "title_field": "title",
     "listing_marker": "div.view-empty"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}
