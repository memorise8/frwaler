{
  "version": 1,
  "sites": {
    "stats-govt-nz-publications": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "html"
        ]
      },
      "listing": {
        "url": "https://www.stats.govt.nz/publications/",
        "params": {
          "categoryFiltersID": "385",
          "filters": "Reports"
        },
        "page_param": "start",
        "page_mode": "offset",
        "page_size": 12,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "page_link",
          "key_field": "ID",
          "date_field": "PageDate",
          "title_field": "Title",
          "listing_marker": "#pageViewData"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
