{
  "version": 1,
  "sites": {
    "hi-no-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.hi.no",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.hi.no/en/hi/nettrapporter",
        "params": {
          "query": ""
        },
        "page_param": "start",
        "start_page": 0,
        "page_mode": "offset",
        "page_size": 30,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "title",
          "date_field": "listed_date_raw",
          "listing_marker": "div.reportlist h2.padd2"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}