{
  "version": 1,
  "sites": {
    "publikationen-bundesregierung-de-pp-de": {
      "strategy": "last_page_backward",
      "base_url": "https://www.publikationen-bundesregierung.de",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "url",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.publikationen-bundesregierung.de/pp-de/2277526!searchJson",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "body": {
          "search": {
            "query": "",
            "zipCodeCityQuery": "",
            "sortOrder": "sortDate desc",
            "page": "{page}"
          },
          "filters": []
        },
        "start_page": 1,
        "page_size": 10,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "title_field": "title",
          "date_field": "sort_date"
        },
        "total": {
          "type": "json",
          "path": "result.count"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
