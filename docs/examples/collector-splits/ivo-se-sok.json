{
  "version": 1,
  "sites": {
    "ivo-se-sok": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "strategy": "last_page_backward",
      "base_url": "https://www.ivo.se",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.ivo.se/sok/",
        "params": {
          "q": " ",
          "s": 0,
          "f": 1,
          "p": 1
        },
        "page_param": "p",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "#search-result"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}