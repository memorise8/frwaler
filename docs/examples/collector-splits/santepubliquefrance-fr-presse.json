{
  "version": 1,
  "sites": {
    "santepubliquefrance-fr-presse": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.santepubliquefrance.fr/presse",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": ".view-list-press"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
