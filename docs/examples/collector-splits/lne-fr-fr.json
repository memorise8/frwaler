{
  "version": 1,
  "sites": {
    "lne-fr-fr": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.lne.fr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.lne.fr/fr/communiques-de-presse",
        "params": {
          "page": 0,
          "sort_by": "field_presse_date_value",
          "sort_order": "DESC"
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "list_title",
          "listing_marker": ".liste__content"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
