{
  "version": 1,
  "sites": {
    "scourt-go-kr-portal": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.scourt.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.scourt.go.kr/portal/news/NewsListAction.work",
        "params": {
          "gubun": "6"
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "list_date",
          "title_field": "title",
          "listing_marker": "div.pagelist"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}