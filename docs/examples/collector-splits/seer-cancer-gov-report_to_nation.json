{
  "version": 1,
  "sites": {
    "seer-cancer-gov-report_to_nation": {
      "strategy": "last_page_backward",
      "base_url": "https://seer.cancer.gov",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper"
      },
      "listing": {
        "url": "https://seer.cancer.gov/report_to_nation/previous.html",
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "slug",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
