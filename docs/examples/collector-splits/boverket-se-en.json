{
  "version": 1,
  "sites": {
    "boverket-se-en": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.boverket.se",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.boverket.se/en/start/publications/",
        "params": {
          "format": "rss"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "guid",
          "date_field": "pub_date",
          "title_field": "title",
          "listing_marker": "channel"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}