{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "vtg-admin-ch-en": {
   "strategy": "last_page_backward",
   "base_url": "https://www.vtg.admin.ch",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "list_returns_paper": true
   },
   "listing": {
    "url": "https://www.vtg.admin.ch/en/swiss-peace-supporter-4",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "pdf_url",
     "title_field": "title",
     "date_field": "published_date"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}
