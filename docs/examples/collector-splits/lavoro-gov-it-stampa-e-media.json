{
  "version": 1,
  "sites": {
    "lavoro-gov-it-stampa-e-media": {
      "strategy": "last_page_backward",
      "base_url": "https://www.lavoro.gov.it",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.lavoro.gov.it/stampa-e-media/Comunicati/Pagine/Comunicati",
        "page_param": "page",
        "start_page": 0,
        "page_size": 20,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}