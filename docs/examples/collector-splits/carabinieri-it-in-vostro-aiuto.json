{
  "version": 1,
  "sites": {
    "carabinieri-it-in-vostro-aiuto": {
      "strategy": "last_page_backward",
      "base_url": "https://www.carabinieri.it",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.carabinieri.it/in-vostro-aiuto/informazioni/comunicati-stampa/!page/page/{page}",
        "first_page_url": "https://www.carabinieri.it/in-vostro-aiuto/informazioni/comunicati-stampa",
        "params": {
          "d": "all"
        },
        "start_page": 1,
        "page_size": 20,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "title_field": "title",
          "date_field": "listed_date",
          "listing_marker": "table.tabella"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
