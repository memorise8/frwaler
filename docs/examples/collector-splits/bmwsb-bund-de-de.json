{
  "version": 1,
  "sites": {
    "bmwsb-bund-de-de": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.bmwsb.bund.de",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.bmwsb.bund.de/DE/ministerium/gesetzgebungsverfahren/gesetzgebungsverfahren_node.html?gtp=122226_Dokumente%3D{page}",
        "first_page_url": "https://www.bmwsb.bund.de/DE/ministerium/gesetzgebungsverfahren/gesetzgebungsverfahren_node.html",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "list_title",
          "listing_marker": "div.l-article__content"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
