{
  "version": 1,
  "sites": {
    "alrc-gov-au-publications": {
      "strategy": "last_page_backward",
      "base_url": "https://www.alrc.gov.au",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.alrc.gov.au/publications/final-report/",
        "page_param": "paged",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "title_field": "title",
          "date_field": "listed_date",
          "listing_marker": "section.section-listing"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}