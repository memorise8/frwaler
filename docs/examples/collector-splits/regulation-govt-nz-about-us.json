{
  "version": 1,
  "sites": {
    "regulation-govt-nz-about-us": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.regulation.govt.nz/about-us/our-publications/search/",
        "params": {
          "query": "",
          "order": "relevance",
          "publication_type_id[110]": 110,
          "sort_date_from": "",
          "sort_date_to": "",
          "start": 0
        },
        "page_param": "start",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date_raw",
          "listing_marker": "main"
        },
        "page_mode": "offset",
        "page_size": 12
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
