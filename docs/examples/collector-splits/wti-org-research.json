{
  "version": 1,
  "sites": {
    "wti-org-research": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.wti.org/research/publications/?type=2",
        "params": {
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "pub_id",
          "listing_marker": "select#id_type"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
