{
  "version": 1,
  "sites": {
    "icn-artem-com-en": {
      "strategy": "sitemap",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.icn-artem.com",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "request_url"
        ]
      },
      "sitemap": {
        "sitemap_url": "https://www.icn-artem.com/post-sitemap.xml",
        "include": [
          "icn-artem\\.com/en/"
        ],
        "exclude": [
          "^https://www\\.icn-artem\\.com/en/(?:students|international|executive-education|business-relations|news/|formation|contact)"
        ]
      }
    }
  }
}