{
  "version": 1,
  "sites": {
    "kna-forest-go-kr-kfsweb": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://kna.forest.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://kna.forest.go.kr/kfsweb/kfi/kfs/kna/application/publication/list.do",
        "params": {
          "mainCd": "210103",
          "mn": "UKNA_04_10",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "span.paging_count"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
