{
  "version": 1,
  "sites": {
    "nida-nih-gov-research-topics": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://nida.nih.gov",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://api.nida.nih.gov/api/content_index/search",
        "params": {
          "sort": "unified_date:desc",
          "from": 0,
          "size": 25,
          "contentCateogry": "Publications,Research Report,DrugFacts"
        },
        "page_param": "from",
        "page_mode": "offset",
        "page_size": 25,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
