{
  "version": 1,
  "sites": {
    "educacionfpydeportes-gob-es-prensahtml": {
      "strategy": "last_page_backward",
      "base_url": "https://www.educacionfpydeportes.gob.es",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.educacionfpydeportes.gob.es/prensa/actualidad.html",
        "params": {
          "texto": "",
          "desde": "2000-01-01",
          "hasta": "2030-12-31"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
