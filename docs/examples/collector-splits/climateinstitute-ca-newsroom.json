{
  "version": 1,
  "sites": {
    "climateinstitute-ca-newsroom": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://climateinstitute.ca/wp-json/wp/v2/news",
        "params": {
          "page": 1,
          "per_page": 100,
          "orderby": "date",
          "order": "desc",
          "_fields": "id,title,excerpt,content,date,link,slug"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "link",
          "key_field": "id",
          "date_field": "date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
