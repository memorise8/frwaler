{
  "version": 1,
  "sites": {
    "minedu-gov-gr-grafeio-typoy-kai-di": {
      "strategy": "last_page_backward",
      "base_url": "https://www.minedu.gov.gr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.minedu.gov.gr/grafeio-typoy-kai-dimosion-sxeseon/deltia-typoy",
        "page_param": "start",
        "page_mode": "offset",
        "page_size": 20,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "div.custom-article-list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}