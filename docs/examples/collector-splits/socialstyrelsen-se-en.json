{
  "version": 1,
  "sites": {
    "socialstyrelsen-se-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.socialstyrelsen.se",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "raw",
          "first_html",
          "url",
          "first_url",
          "item"
        ],
        "second_step": {
          "use": "detail_page",
          "selector": "a[class*=\"publication-wrapper__main-doc\"][href$=\".pdf\" i], a[href*=\"/contentassets/\"][href*=\".pdf\" i]",
          "attr": "href",
          "required": false
        }
      },
      "listing": {
        "url": "https://www.socialstyrelsen.se/en/publications/",
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "published_date",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}