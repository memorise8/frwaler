{
  "version": 1,
  "sites": {
    "fss-or-kr-fss": {
      "strategy": "last_page_backward",
      "base_url": "https://www.fss.or.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.fss.or.kr/fss/bbs/B0000188/list.do",
        "params": {
          "menuNo": "200218"
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "ntt_id",
          "url_field": "detail_url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": ".krds-table-wrap table.list-data"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
