{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "dst-dk-da": {
   "strategy": "last_page_backward",
   "base_url": "https://www.dst.dk",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.dst.dk/da/Statistik/udgivelser",
    "params": {
     "pub": "pub",
     "page": 1
    },
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "pub_id",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": "main"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}