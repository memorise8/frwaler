{
  "version": 1,
  "sites": {
    "difesa-it-il-ministro": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.difesa.it",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.difesa.it/data/il-ministro/note-stampa/elenco.json",
        "params": {
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "contentitemid",
          "url_field": "detail_url",
          "title_field": "titolo",
          "date_field": "contentitemdata"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
