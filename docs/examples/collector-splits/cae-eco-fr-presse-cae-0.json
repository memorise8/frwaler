{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "cae-eco-fr-presse-cae-0": {
   "strategy": "last_page_backward",
   "base_url": "https://cae-eco.fr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://cae-eco.fr/Presse-CAE-{page}",
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "slug",
     "url_field": "url",
     "title_field": "list_title",
     "listing_marker": "div.portfolio"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}