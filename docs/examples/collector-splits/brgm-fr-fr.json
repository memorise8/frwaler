{
  "version": 1,
  "sites": {
    "brgm-fr-fr": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_build_paper",
        "detail_args": [
          "soup",
          "html",
          "item",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.brgm.fr/fr/actualites?type=Communiqu%C3%A9%20de%20presse",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
