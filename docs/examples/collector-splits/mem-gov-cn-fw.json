{
  "version": 1,
  "sites": {
    "mem-gov-cn-fw": {
      "strategy": "last_page_backward",
      "base_url": "https://www.mem.gov.cn",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.mem.gov.cn/fw/yajzjxzxk/zjxzxksxbljg/index_{page}.shtml",
        "first_page_url": "https://www.mem.gov.cn/fw/yajzjxzxk/zjxzxksxbljg/",
        "start_page": 0,
        "page_size": 20,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "list_date",
          "title_field": "list_title",
          "listing_marker": "div.tonglan_list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
