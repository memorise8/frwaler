{
  "version": 1,
  "sites": {
    "mpva-go-kr-mpva": {
      "strategy": "last_page_backward",
      "base_url": "https://www.mpva.go.kr",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.mpva.go.kr/mpva/selectBbsNttList.do",
        "params": {
          "bbsNo": "16",
          "key": "77",
          "searchCtgry": "",
          "searchCnd": "all",
          "searchKrwd": "",
          "integrDeptCode": "",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "page_size": 10,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "ntt_no",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "table.p-table"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}