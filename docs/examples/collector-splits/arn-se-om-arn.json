{
  "version": 1,
  "sites": {
    "arn-se-om-arn": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://www.arn.se",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper"
      },
      "listing": {
        "url": "https://www.arn.se/om-arn/arsredovisning/",
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "key_field": "external_id",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": "#main-content"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}