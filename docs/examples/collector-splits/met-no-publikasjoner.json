{
  "version": 1,
  "sites": {
    "met-no-publikasjoner": {
      "strategy": "date_range_split",
      "base_url": "https://www.met.no",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "raw",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.met.no/publikasjoner/{segment}",
        "page_param": "page",
        "start_page": 1,
        "page_size": 40,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "key_field": "external_id",
          "title_field": "title",
          "listing_marker": "#main-container"
        }
      },
      "segments": {
        "mode": "explicit",
