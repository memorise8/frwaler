{
  "version": 1,
  "sites": {
    "opm-go-kr-opm": {
      "strategy": "last_page_backward",
      "request_interval_s": 3,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.opm.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.opm.go.kr/opm/news/press-release.do",
        "params": {
          "mode": "list",
          "article.offset": 0,
          "articleLimit": "10"
        },
        "page_param": "article.offset",
        "page_mode": "offset",
        "page_size": 10,
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "article_no",
          "url_field": "url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "tbody"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}