{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "sodha-be-dataverse": {
   "strategy": "last_page_backward",
   "base_url": "https://www.sodha.be",
   "adapter": {
    "type": "crawler",
    "contract_version": 1,
    "list_method": "_enumeration_items",
    "list_args": [
     "json"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "json",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.sodha.be/api/search",
    "params": {
     "q": "*",
     "type": "dataset",
     "subtree": "sodha",
     "sort": "name",
     "order": "asc",
     "per_page": "50",
     "start": 0
    },
    "page_param": "start",
    "page_mode": "offset",
    "page_size": 50,
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "global_id",
     "url_field": "_enumeration_detail_api_url",
     "title_field": "name"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}