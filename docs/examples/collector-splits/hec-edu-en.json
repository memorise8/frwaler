{
  "version": 1,
  "sites": {
    "hec-edu-en": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.hec.edu",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.hec.edu/en/list-press-release",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "key_field": "url",
          "url_field": "url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "#edit-submit-press-release-list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}