{
 "version": 1,
 "sites": {
  "academie-sciences-fr-espace-presse": {
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "strategy": "last_page_backward",
   "base_url": "https://www.academie-sciences.fr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_detail",
    "detail_args": [
     "raw",
     "pdf_text",
     "item"
    ],
    "pdf_text": {
     "args": [
      "-layout"
     ],
     "timeout_s": 90,
     "min_bytes": 0
    }
   },
   "listing": {
    "url": "https://www.academie-sciences.fr/espace-presse",
    "page_param": "page",
    "start_page": 0,
    "page_size": 10,
    "parser": {
     "type": "adapter",
     "key_field": "key",
     "url_field": "url",
     "date_field": "listed_date",
     "title_field": "title",
     "listing_marker": "div.NodeEdito-view"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}
