{
  "version": 1,
  "sites": {
    "portaldiplomatico-mne-gov-pt-en": {
      "strategy": "last_page_backward",
      "base_url": "https://portaldiplomatico.mne.gov.pt",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://portaldiplomatico.mne.gov.pt/en/communication-and-media/press-releases",
        "page_param": "start",
        "page_mode": "offset",
        "page_size": 6,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "slug",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "div.blog"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}