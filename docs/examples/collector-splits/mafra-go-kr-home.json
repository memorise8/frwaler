{
  "version": 1,
  "defaults": {"request_interval_s": 1.5, "respect_robots": true, "retries": 1},
  "sites": {
    "mafra-go-kr-home": {
      "strategy": "last_page_backward",
      "base_url": "https://www.mafra.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": ["html", "url"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["html", "item"]
      },
      "listing": {
        "url": "https://www.mafra.go.kr/bbs/home/792/artclList.do",
        "params": {"page": 1, "row": "10"},
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "bbsArtclSeq",
          "url_field": "url",
          "title_field": "title",
          "date_field": "listed_date",
          "listing_marker": "._articleTable .list table"
        }
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
