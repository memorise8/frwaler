{
  "version": 1,
  "sites": {
    "waltoninstitute-ie-research": {
      "strategy": "last_page_backward",
      "base_url": "https://waltoninstitute.ie",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "json",
          "item"
        ]
      },
      "listing": {
        "url": "https://wordpress.waltoninstitute.ie/wp-json/wp/v2/publication",
        "params": {
          "per_page": 100,
          "_fields": "id,date,slug,link"
        },
        "page_param": "page",
        "start_page": 1,
        "page_size": 100,
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "slug"
        },
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ]
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
