{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "bam-de-navigation": {
   "strategy": "oldest_first_sort",
   "base_url": "https://www.bam.de",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://bam.de/en/news/papers-of-the-month",
    "start_page": 1,
    "next_link": {
     "selector": "a.page-forward",
     "attr": "href"
    },
    "parser": {
     "type": "adapter",
     "url_field": "url",
     "listing_marker": "main"
    }
   }
  }
 }
}