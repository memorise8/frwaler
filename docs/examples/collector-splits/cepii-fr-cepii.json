{
  "version": 1,
  "sites": {
    "cepii-fr-cepii": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.cepii.fr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.cepii.fr/CEPII/fr/publications/reports.asp",
        "params": {
          "offset": 0
        },
        "page_param": "offset",
        "page_mode": "offset",
        "page_size": 10,
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "noDoc",
          "title_field": "title",
          "listing_marker": "div.colonnepage530px"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}