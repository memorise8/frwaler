{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "english-www-gov-cn-archive": {
   "strategy": "last_page_backward",
   "base_url": "https://english.www.gov.cn",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://english.www.gov.cn/archive/statecouncilgazette/page_{page}.html",
    "first_page_url": "https://english.www.gov.cn/archive/statecouncilgazette/",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": ".Gazette_List"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}