{
  "version": 1,
  "sites": {
    "mimit-gov-it-it": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_parse_detail_page",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.mimit.gov.it/it/per-i-media/pubblicazioni",
        "params": {
          "start": 0
        },
        "page_param": "start",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date",
          "listing_marker": "main"
        },
        "page_mode": "offset",
        "page_size": 10
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
