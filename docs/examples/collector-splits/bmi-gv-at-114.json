{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "bmi-gv-at-114": {
   "strategy": "last_page_backward",
   "base_url": "https://www.bmi.gv.at",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "list_returns_paper": true,
    "allow_shared_post_number": true
   },
   "listing": {
    "url": "https://www.bmi.gv.at/114/start.aspx",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "post_number",
     "url_field": "url",
     "title_field": "title",
     "date_field": "published_date"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}
