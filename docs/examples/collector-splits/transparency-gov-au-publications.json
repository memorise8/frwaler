{
  "version": 1,
  "sites": {
    "transparency-gov-au-publications": {
      "strategy": "last_page_backward",
      "base_url": "https://www.transparency.gov.au",
      "request_headers": {
        "Accept": "application/json"
      },
      "request_headers_env": {
        "api-key": "TRANSPARENCY_GOV_AU_PUBLICATIONS_KEY"
      },
      "request_headers_hosts": [
        "acs-dof-shared-aue-01.search.windows.net"
      ],
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://acs-dof-shared-aue-01.search.windows.net/indexes/prod-content-index/docs/search?api-version=2024-05-01-preview",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "params": {
          "search": "",
          "searchMode": "all",
          "filter": "search.in(ContentType, 'annual_report|corp_plan|pbs', '|')",
          "orderby": "ReportingYear desc",
          "top": 50,
          "count": true,
          "queryType": "simple"
        },
        "page_param": "skip",
        "page_mode": "offset",
        "page_size": 50,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "ID",
          "title_field": "title"
        },
        "total": {
          "type": "json",
          "path": "@odata.count"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
