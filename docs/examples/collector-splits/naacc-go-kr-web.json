{
  "version": 1,
  "sites": {
    "naacc-go-kr-web": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://naacc.go.kr/WEB/contents/N4020000000.do",
        "params": {
          "schM": "list",
          "viewCount": "10",
          "id": "",
          "schBdcode": "",
          "schGroupCode": ""
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "file_id",
          "url_field": "pdf_url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "div.tableWrap"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
