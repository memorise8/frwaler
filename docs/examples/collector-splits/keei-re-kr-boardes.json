{
  "version": 1,
  "sites": {
    "keei-re-kr-boardes": {
      "strategy": "last_page_backward",
      "request_interval_s": 10,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.keei.re.kr/board.es",
        "params": {
          "mid": "a10101010000",
          "bid": "0001",
          "nPage": 1
        },
        "page_param": "nPage",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "list_no",
          "url_field": "url",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": "ul.report_list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
