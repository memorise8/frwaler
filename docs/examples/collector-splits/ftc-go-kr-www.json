{
  "version": 1,
  "sites": {
    "ftc-go-kr-www": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.ftc.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.ftc.go.kr/www/selectBbsNttList.do",
        "params": {
          "pageUnit": 10,
          "searchCnd": "all",
          "key": "12",
          "bordCd": "3",
          "searchCtgry": "01,02",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "pub_date",
          "title_field": "title",
          "listing_marker": "table.p-table"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
