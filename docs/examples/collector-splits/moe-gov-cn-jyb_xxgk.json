{
  "version": 1,
  "sites": {
    "moe-gov-cn-jyb_xxgk": {
      "strategy": "last_page_backward",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "http://www.moe.gov.cn/jyb_xxgk/xxgk/nianbao/jiguan/",
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "dl#list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "base_url": "http://www.moe.gov.cn",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
