{
  "version": 1,
  "sites": {
    "migration-gov-gr-press": {
      "strategy": "last_page_backward",
      "base_url": "https://migration.gov.gr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://migration.gov.gr/wp-json/wp/v2/posts",
        "params": {
          "categories": 23,
          "per_page": 10,
          "page": 1,
          "_fields": "id,date,modified,slug,link,title,content,excerpt",
          "orderby": "date",
          "order": "desc"
        },
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ],
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "link",
          "key_field": "id",
          "date_field": "date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
