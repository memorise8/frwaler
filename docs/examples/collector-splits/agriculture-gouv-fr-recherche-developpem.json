{
  "version": 1,
  "sites": {
    "agriculture-gouv-fr-recherche-developpem": {
      "strategy": "last_page_backward",
      "base_url": "https://agriculture.gouv.fr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://agriculture.gouv.fr/espace-presse?query=&sort_by=created&thematiques=recherche-developpement-et-innovation",
        "page_param": "pg",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "url",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
