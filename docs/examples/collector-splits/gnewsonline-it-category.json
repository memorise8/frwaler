{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "gnewsonline-it-category": {
   "strategy": "last_page_backward",
   "base_url": "https://www.gnewsonline.it",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.gnewsonline.it/category/comunicati-stampa/page/{page}/",
    "first_page_url": "https://www.gnewsonline.it/category/comunicati-stampa/",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "url_field": "url",
     "listing_marker": "body.category"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}