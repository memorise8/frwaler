{
  "version": 1,
  "sites": {
    "incheon-go-kr-ic010205": {
      "strategy": "last_page_backward",
      "base_url": "https://www.incheon.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.incheon.go.kr/IC010205",
        "page_param": "curPage",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "rep_seq",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": "div.board-blog-list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
