{
  "version": 1,
  "sites": {
    "olympias-lib-uoi-gr-jspui": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://olympias.lib.uoi.gr/jspui/simple-search",
        "params": {
          "query": "",
          "filter_field_1": "type",
          "filter_type_1": "equals",
          "filter_value_1": "doctoralThesis",
          "sort_by": "score",
          "order": "desc",
          "rpp": 20,
          "etal": 0,
          "start": 0
        },
        "page_param": "start",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date",
          "listing_marker": "main"
        },
        "page_mode": "offset",
        "page_size": 20
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
