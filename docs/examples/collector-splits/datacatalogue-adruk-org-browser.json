{
  "version": 1,
  "sites": {
    "datacatalogue-adruk-org-browser": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "json",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://api-datacatalogue.adruk.org/api/dataset",
        "params": {
          "include": "dataset::datastandard::terminology::dataclass::dataelement",
          "pageNumber": 1,
          "pageSize": 100
        },
        "page_param": "pageNumber",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "key"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}