{
  "version": 1,
  "sites": {
    "wallonie-be-fr": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "final_url",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.wallonie.be/fr/publications",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "nav.pager spw-pagination"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
