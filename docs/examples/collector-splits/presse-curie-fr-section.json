{
  "version": 1,
  "sites": {
    "presse-curie-fr-section": {
      "strategy": "last_page_backward",
      "base_url": "https://presse.curie.fr",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "request_headers": {
        "Referer": "https://presse.curie.fr/section/communiques/?lang=en"
      },
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ],
        "none_is_rule_skip": true
      },
      "listing": {
        "url": "https://presse.curie.fr/wp-admin/admin-ajax.php",
        "method": "POST",
        "idempotent": true,
        "body_type": "form",
        "params": {
          "action": "load_more_post",
          "query_args[category_name]": "communiques",
          "posts_per_page": "10",
          "type": "loadmore",
          "load_more_is_activated": "1",
          "total": "9999",
          "security": "{dyn:nonce}",
          "hash": "crawlerabc"
        },
        "page_param": "offset",
        "page_mode": "offset",
        "page_size": 10,
        "start_page": 1,
        "end_on_blank_body": true,
        "dynamic": {
          "url": "https://presse.curie.fr/section/communiques/?lang=en",
          "values": {
            "nonce": {
              "regex": "ajaxurlPostNonce\\s*=\\s*\\{[^}]*\"nonce\"\\s*:\\s*\"([a-f0-9]+)\""
            }
          }
        },
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": false
      }
    }
  }
}
