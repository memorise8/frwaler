{
  "version": 1,
  "sites": {
    "juventudeinfancia-gob-es-es": {
      "strategy": "last_page_backward",
      "verify_ssl": false,
      "base_url": "https://www.juventudeinfancia.gob.es",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.juventudeinfancia.gob.es/es/comunicacion/notas-prensa",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "div.view-display-id-page_1"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
