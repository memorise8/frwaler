{
  "version": 1,
  "sites": {
    "pbl-nl-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.pbl.nl",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.pbl.nl/en/publications?key=&type%5B28%5D=28&published%5Bmin%5D=&published%5Bmax%5D=",
        "page_param": "page",
        "start_page": 0,
        "page_size": 10,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": ".view-publications-overview"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
