{
  "version": 1,
  "sites": {
    "hcsp-fr-explorecgi": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.hcsp.fr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "url",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.hcsp.fr/Explore.cgi/avisrapports",
        "params": {
          "Annee": "",
          "Langue": "",
          "Type": "c",
          "MC0": "0",
          "MC1": "",
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": "table#resultats"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}