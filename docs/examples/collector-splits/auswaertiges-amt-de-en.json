{
  "version": 1,
  "sites": {
    "auswaertiges-amt-de-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.auswaertiges-amt.de",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.auswaertiges-amt.de/ajax/json-filterlist/en/newsroom/news/609204-609204",
        "page_param": "offset",
        "page_mode": "offset",
        "page_size": 20,
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "headline"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}