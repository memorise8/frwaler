{
  "version": 1,
  "sites": {
    "srnl-gov-newsroom": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "html"
        ]
      },
      "listing": {
        "url": "https://www.srnl.gov/wp-json/wp/v2/news-releases",
        "params": {
          "page": 1,
          "per_page": 10,
          "_fields": "id,slug,title,date,link"
        },
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ],
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "link",
          "key_field": "id",
          "date_field": "date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
