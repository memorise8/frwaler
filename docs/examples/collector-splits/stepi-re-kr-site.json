{
  "version": 1,
  "sites": {
    "stepi-re-kr-site": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "html"
        ]
      },
      "listing": {
        "url": "https://www.stepi.re.kr/site/stepiko/report/List.do",
        "params": {
          "cateCont": "A0205"
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "display_num",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "tbody"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
