{
  "version": 1,
  "sites": {
    "asiapacific-ca-media": {
      "strategy": "last_page_backward",
      "base_url": "https://www.asiapacific.ca",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.asiapacific.ca/media/press-releases",
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "node_id",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}