{
  "version": 1,
  "sites": {
    "mois-go-kr-frt": {
      "strategy": "last_page_backward",
      "base_url": "https://www.mois.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.mois.go.kr/frt/bbs/type010/commonSelectBoardList.do",
        "params": {
          "bbsId": "BBSMSTR_000000000008",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "table.table_style1"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
