{
  "version": 1,
  "sites": {
    "um-dk-om-os": {
      "strategy": "last_page_backward",
      "base_url": "https://um.dk",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper"
      },
      "listing": {
        "url": "https://um.dk/om-os/organisation/oekonomi-og-udbud/oekonomi-maal-og-resultater",
        "page_param": "page",
        "start_page": 1,
        "page_size": 30,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "link_text",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
