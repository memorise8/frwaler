{
  "version": 1,
  "sites": {
    "who-int-publications": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.who.int",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.who.int/api/hubs/publications?sf_site=15210d59-ad60-47ff-a542-7ed76645f0c7&sf_provider=OpenAccessProvider&sf_culture=en&$orderby=PublicationDateAndTime%20desc&$count=true&$select=Title,ItemDefaultUrl,FormatedDate,Tag,DownloadUrl&$top=20",
        "page_param": "$skip",
        "page_mode": "offset",
        "page_size": 20,
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "published_date",
          "title_field": "Title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
