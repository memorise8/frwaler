{
  "version": 1,
  "sites": {
    "nkvts-no-english": {
      "strategy": "last_page_backward",
      "base_url": "https://www.nkvts.no",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "request_headers": {
        "X-Algolia-Application-Id": "A4EOX51ZO9"
      },
      "request_headers_env": {
        "X-Algolia-API-Key": {
          "env": "NKVTS_NO_ENGLISH_KEY",
          "format": "{}"
        }
      },
      "request_headers_hosts": [
        "a4eox51zo9-dsn.algolia.net"
      ],
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://a4eox51zo9-dsn.algolia.net/1/indexes/wp_searchable_posts/query",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "params": {
          "query": "",
          "hitsPerPage": 50,
          "facetFilters": [
            "post_type_label:Academic Articles"
          ]
        },
        "page_param": "page",
        "start_page": 0,
        "page_size": 50,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "published_date",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
