{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "lecese-fr-espace-presse": {
   "strategy": "last_page_backward",
   "base_url": "https://www.lecese.fr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.lecese.fr/espace-presse",
    "params": {
     "page": 0
    },
    "page_param": "page",
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "url",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": ".view-id-communiques"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}