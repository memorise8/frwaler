{
  "version": 1,
  "sites": {
    "diplomatie-gouv-fr-en": {
      "strategy": "last_page_backward",
      "base_url": "https://www.diplomatie.gouv.fr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.diplomatie.gouv.fr/en/press/news",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "key_field": "url",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": ".views-element-container"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}