{
  "version": 1,
  "sites": {
    "publicservice-govt-nz-research-and-data": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "resp",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.publicservice.govt.nz/research-and-data",
        "params": {
          "q": "",
          "classification": "datasheet",
          "topics[0]": "193",
          "start": 0
        },
        "page_param": "start",
        "start_page": 0,
        "page_mode": "offset",
        "page_size": 25,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": "#DirectoryFilterForm_getDirectoryFilterForm_topics"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}