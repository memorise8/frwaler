{
  "version": 1,
  "sites": {
    "kamco-or-kr-portal": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.kamco.or.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.kamco.or.kr/portal/bbs/list.do",
        "params": {
          "ptIdx": "284",
          "mId": "0705010000",
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "listing_marker": "table.board-table"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}