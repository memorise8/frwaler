{
  "version": 1,
  "sites": {
    "defence-govt-nz-publications": {
      "strategy": "last_page_backward",
      "base_url": "https://www.defence.govt.nz",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.defence.govt.nz/publications/doSearch/",
        "page_param": "start",
        "start_page": 0,
        "page_mode": "offset",
        "page_size": 10,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "url",
          "title_field": "title",
          "date_field": "date_raw",
          "listing_marker": ".search-page__results"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}