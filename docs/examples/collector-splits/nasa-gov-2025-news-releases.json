{
  "version": 1,
  "sites": {
    "nasa-gov-2025-news-releases": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://www.nasa.gov/wp-json/wp/v2/press-release",
        "params": {
          "page": 1,
          "per_page": 100,
          "after": "2025-01-01T00:00:00",
          "before": "2026-01-01T00:00:00",
          "_fields": "id,date,slug,title,excerpt,link,content"
        },
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ],
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "link",
          "key_field": "id",
          "date_field": "date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
