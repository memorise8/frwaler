{
  "version": 1,
  "sites": {
    "en-nim-ac-cn-taxonomy": {
      "strategy": "last_page_backward",
      "base_url": "https://en.nim.ac.cn",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://en.nim.ac.cn/taxonomy/term/170",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": ".view-kxyj-lwzl-lw"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
