{
  "version": 1,
  "sites": {
    "issnationallab-org-about": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "verify_ssl": true,
      "base_url": "https://issnationallab.org",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://issnationallab.org/about/annual-quarterly-reports-metrics/",
        "page_param": "page",
        "start_page": 1,
        "page_size": 36,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "fetch_url",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": ".page-content"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}