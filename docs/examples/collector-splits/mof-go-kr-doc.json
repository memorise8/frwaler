{
  "version": 1,
  "sites": {
    "mof-go-kr-doc": {
      "strategy": "last_page_backward",
      "base_url": "https://www.mof.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.mof.go.kr/doc/ko/selectDocList.do",
        "params": {
          "paginationInfo.currentPageNo": 1,
          "menuSeq": "971",
          "bbsSeq": "10"
        },
        "page_param": "paginationInfo.currentPageNo",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "listing_marker": "table.bod-table-list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
