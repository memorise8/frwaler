{
  "version": 1,
  "sites": {
    "education-ni-gov-uk-news": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          {
            "source": "query",
            "path": [
              "page"
            ],
            "type": "int"
          }
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.education-ni.gov.uk/news",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "datetime_attr",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": false
      }
    }
  }
}
