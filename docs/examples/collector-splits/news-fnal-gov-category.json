{
  "version": 1,
  "sites": {
    "news-fnal-gov-category": {
      "strategy": "last_page_backward",
      "base_url": "https://news.fnal.gov",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "json"
        ]
      },
      "listing": {
        "url": "https://news.fnal.gov/wp-json/wp/v2/posts",
        "params": {
          "categories": 55,
          "per_page": 100,
          "page": 1,
          "_embed": 1
        },
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ],
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "detail_api_url",
          "key_field": "id",
          "date_field": "date",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
