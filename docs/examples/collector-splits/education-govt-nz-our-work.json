{
  "version": 1,
  "sites": {
    "education-govt-nz-our-work": {
      "strategy": "last_page_backward",
      "base_url": "https://www.education.govt.nz",
      "request_headers": {
        "x-algolia-application-id": "ZJYLA4J4R6"
      },
      "request_headers_env": {
        "x-algolia-api-key": "EDUCATION_GOVT_NZ_OUR_WORK_KEY"
      },
      "request_headers_hosts": [
        "zjyla4j4r6-dsn.algolia.net"
      ],
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://zjyla4j4r6-dsn.algolia.net/1/indexes/date_desc_live/query",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "params": {
          "filters": "status:true AND entity_type:content AND (result.lvl1:\"Pages > Guidance\" OR result.lvl1:\"Pages > Information\") AND level_1:\"our work\" AND level_2:\"publications\" AND level_3:\"education circulars\" AND show_in_topic_search:true",
          "hitsPerPage": 20
        },
        "page_param": "page",
        "start_page": 0,
        "page_size": 20,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "post_number",
          "title_field": "title"
        },
        "total": {
          "type": "json",
          "path": "nbHits"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
