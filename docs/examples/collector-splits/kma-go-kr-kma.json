{
  "version": 1,
  "sites": {
    "kma-go-kr-kma": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.kma.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "raw",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "raw",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.kma.go.kr/kma/news/press_01.jsp",
        "params": {
          "mode": "list",
          "bid": "press"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "tbody"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
