{
  "version": 1,
  "sites": {
    "bdap-opendata-rgs-mef-gov-it-catalog": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://bdap-opendata.rgs.mef.gov.it",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "raw"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "raw",
          "item"
        ]
      },
      "listing": {
        "url": "https://bdap-opendata.rgs.mef.gov.it/catalog",
        "params": {
          "page": 0
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": "ol.search-results"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
