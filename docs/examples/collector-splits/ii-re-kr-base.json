{
  "version": 1,
  "sites": {
    "ii-re-kr-base": {
      "strategy": "last_page_backward",
      "base_url": "https://www.ii.re.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.ii.re.kr/base/board/list",
        "params": {
          "boardManagementNo": "14",
          "menuLevel": "2",
          "menuNo": "76"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "board_no",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "div.board-img__list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
