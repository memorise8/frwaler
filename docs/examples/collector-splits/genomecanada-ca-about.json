{
  "version": 1,
  "sites": {
    "genomecanada-ca-about": {
      "strategy": "last_page_backward",
      "base_url": "https://genomecanada.ca",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "pdf_text",
          "item"
        ],
        "pdf_text": {
          "args": [
            "-l",
            "5"
          ],
          "timeout_s": 30,
          "min_bytes": 0
        }
      },
      "listing": {
        "url": "https://genomecanada.ca/about/publications/",
        "page_param": "page",
        "start_page": 1,
        "page_size": 60,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "key_field": "external_id",
          "title_field": "title",
          "date_field": "upload_date",
          "listing_marker": "ul.elementor-icon-list-items"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
