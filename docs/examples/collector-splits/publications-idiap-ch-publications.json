{
 "version": 1,
 "defaults": {
  "request_interval_s": 1.5,
  "respect_robots": true,
  "retries": 1
 },
 "sites": {
  "publications-idiap-ch-publications": {
   "strategy": "last_page_backward",
   "base_url": "https://publications.idiap.ch",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://publications.idiap.ch/publications/articles/page/{page}",
    "first_page_url": "https://publications.idiap.ch/publications/articles",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "external_id",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": "div.publication_summary"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}