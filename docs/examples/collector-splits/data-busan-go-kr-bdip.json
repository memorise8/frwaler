{
  "version": 1,
  "sites": {
    "data-busan-go-kr-bdip": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://data.busan.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://data.busan.go.kr/bdip/srh/getPublicDataListSearch.do",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "params": {
          "searchSort": "REG_DT",
          "dataTy": "",
          "brmnCd": "",
          "insttCd": "",
          "offset": 0,
          "pagelength": 50,
          "listOrderCd": ""
        },
        "page_param": "offset",
        "page_mode": "offset",
        "page_size": 50,
        "start_page": 0,
        "total": {
          "type": "json",
          "path": "result.total_count"
        },
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "pk",
          "title_field": "title",
          "date_field": "listed_date"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": false
      }
    }
  }
}
