{
  "version": 1,
  "sites": {
    "nesc-ie-publications": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "listing": {
        "url": "https://www.nesc.ie/wp-json/nesc/v1/publications-search",
        "params": {
          "paged": 1
        },
        "page_param": "paged",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "date"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
