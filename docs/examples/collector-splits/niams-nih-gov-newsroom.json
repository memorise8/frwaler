{
  "version": 1,
  "sites": {
    "niams-nih-gov-newsroom": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "sitemap",
      "base_url": "https://www.niams.nih.gov",
      "adapter": {
        "type": "crawler",
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "url"
        ]
      },
      "sitemap": {
        "sitemap_url": "https://www.niams.nih.gov/sitemap.xml",
        "include": [
          "^https://www\\.niams\\.nih\\.gov/.*/newsroom/press-releases/[^?#]+|^https://www\\.niams\\.nih\\.gov/newsroom/press-releases/[^?#]+"
        ]
      }
    }
  }
}
