{
  "version": 1,
  "sites": {
    "humanrights-go-kr-base": {
      "strategy": "last_page_backward",
      "base_url": "https://www.humanrights.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.humanrights.go.kr/base/board/list",
        "params": {
          "boardManagementNo": "20",
          "menuLevel": "3",
          "menuNo": "120"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "board_no",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "table.board_list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
