{
  "version": 1,
  "sites": {
    "caitec-org-cn-n6": {
      "strategy": "last_page_backward",
      "base_url": "https://www.caitec.org.cn",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.caitec.org.cn/n6/sy_xsyj_yjbg/json/index_{page}.html",
        "first_page_url": "https://www.caitec.org.cn/n6/sy_xsyj_yjbg/json/index.html",
        "start_page": 1,
        "page_size": 15,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "list_title"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
