{
  "version": 1,
  "sites": {
    "minrel-gob-cl-minrel": {
      "strategy": "last_page_backward",
      "base_url": "https://www.minrel.gob.cl",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.minrel.gob.cl/minrel/sala-de-prensa/p/{page}",
        "start_page": 1,
        "page_size": 51,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "title",
          "date_field": "list_published_date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
