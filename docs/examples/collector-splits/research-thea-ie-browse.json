{
  "version": 1,
  "sites": {
    "research-thea-ie-browse": {
      "strategy": "oldest_first_sort",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://research.thea.ie",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "none_is_rule_skip": true,
        "list_method": "_enumeration_items",
        "list_args": [
          "raw",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "raw"
        ]
      },
      "listing": {
        "url": "https://research.thea.ie/oai/request",
        "params": {
          "verb": "ListRecords",
          "metadataPrefix": "oai_dc"
        },
        "next_link": {
          "selector": "resumptionToken",
          "text": true,
          "template": "https://research.thea.ie/oai/request?verb=ListRecords&resumptionToken={token}"
        },
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "datestamp",
          "title_field": "title",
          "listing_marker": "listrecords"
        }
      }
    }
  }
}