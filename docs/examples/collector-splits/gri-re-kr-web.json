{
  "version": 1,
  "sites": {
    "gri-re-kr-web": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "base_url": "https://www.gri.re.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.gri.re.kr/web/contents/resreport.do",
        "params": {
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "year",
          "title_field": "title",
          "listing_marker": ".issue_table_wrap ul"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
