{
  "version": 1,
  "sites": {
    "knmi-nl-kennis-en-datacentru": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.knmi.nl/kennis-en-datacentrum/zoekresultaten",
        "params": {
          "q": "",
          "sort": "score",
          "type": "data_center_publication",
          "publication_types[]": "knmi_publication",
          "year_from": "2016",
          "year_to": "2026"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "title_field": "title",
          "listing_marker": "#search-results"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}