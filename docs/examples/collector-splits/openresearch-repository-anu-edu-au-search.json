{
  "version": 1,
  "sites": {
    "openresearch-repository-anu-edu-au-search": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "base_url": "https://openresearch-repository.anu.edu.au",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "item",
          "json"
        ]
      },
      "listing": {
        "url": "https://openresearch-repository.anu.edu.au/server/api/discover/search/objects",
        "params": {
          "query": "",
          "dsoType": "item",
          "sort": "dc.date.accessioned,DESC",
          "page": 0,
          "size": 20
        },
        "page_param": "page",
        "start_page": 0,
        "total": {
          "type": "json",
          "path": "_embedded.searchResult.page.totalElements"
        },
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "uuid",
          "date_field": "listed_date"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
