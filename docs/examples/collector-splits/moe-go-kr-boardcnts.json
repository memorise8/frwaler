{
  "version": 1,
  "sites": {
    "moe-go-kr-boardcnts": {
      "strategy": "last_page_backward",
      "base_url": "https://www.moe.go.kr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.moe.go.kr/boardCnts/listRenew.do",
        "params": {
          "type": "default",
          "page": 1,
          "m": "041202",
          "s": "moe",
          "boardID": "345"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "div[data-type=\"list\"] table"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
