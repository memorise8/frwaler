{
  "version": 1,
  "sites": {
    "issnationallab-org-research-and-science": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://issnationallab.org/wp-json/wp/v2/pages",
        "params": {
          "parent": 41447,
          "per_page": 100,
          "page": 1,
          "status": "publish",
          "_fields": "id,date,link,title,slug"
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "date",
          "key_field": "id"
        },
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ]
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
