{
  "version": 1,
  "sites": {
    "artsetmetiers-fr-fr": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://artsetmetiers.fr/fr/communiques-de-presse",
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "date_field": "date",
          "listing_marker": "div.view-espace-presse"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}