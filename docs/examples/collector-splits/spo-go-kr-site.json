{
  "version": 1,
  "sites": {
    "spo-go-kr-site": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.spo.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.spo.go.kr/site/spo/ex/board/List.do",
        "params": {
          "cbIdx": "1303",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "page_size": 9,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": "div.brdNothing"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
