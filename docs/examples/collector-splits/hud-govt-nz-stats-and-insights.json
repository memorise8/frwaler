{
  "version": 1,
  "sites": {
    "hud-govt-nz-stats-and-insights": {
      "strategy": "last_page_backward",
      "base_url": "https://www.hud.govt.nz",
      "request_headers": {
        "X-Requested-With": "XMLHttpRequest"
      },
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper"
      },
      "listing": {
        "url": "https://www.hud.govt.nz/documents/search",
        "params": {
          "q": "",
          "sort": "latest",
          "count": "12"
        },
        "page_param": "start",
        "page_mode": "offset",
        "page_size": 12,
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "detail_url",
          "key_field": "detail_url",
          "title_field": "title",
          "listing_marker": "[data-pagination-link], p"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
