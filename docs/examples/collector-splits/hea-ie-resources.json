{
  "version": 1,
  "sites": {
    "hea-ie-resources": {
      "strategy": "last_page_backward",
      "base_url": "https://hea.ie",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "raw",
          "item"
        ]
      },
      "listing": {
        "url": "https://hea.ie/resources/publications/",
        "page_param": "paged",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "post_number",
          "title_field": "title",
          "date_field": "date",
          "listing_marker": "div.publications_cards"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}