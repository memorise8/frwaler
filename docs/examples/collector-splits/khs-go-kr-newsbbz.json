{
  "version": 1,
  "sites": {
    "khs-go-kr-newsbbz": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.khs.go.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.khs.go.kr/newsBbz/selectNewsBbzList.do",
        "params": {
          "sectionId": "all_sec_1",
          "mn": "NS_01_02",
          "pageIndex": 1
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "news_item_id",
          "url_field": "detail_url",
          "date_field": "date",
          "listing_marker": "table.tbl"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}