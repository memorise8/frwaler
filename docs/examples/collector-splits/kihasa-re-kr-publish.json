{
  "version": 1,
  "sites": {
    "kihasa-re-kr-publish": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.kihasa.re.kr",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.kihasa.re.kr/publish/report/all/list",
        "params": {
          "page": 1
        },
        "page_param": "page",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "seq",
          "url_field": "detail_url",
          "listing_marker": "div.board-list"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}