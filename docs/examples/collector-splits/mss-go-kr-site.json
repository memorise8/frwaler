{
  "version": 1,
  "sites": {
    "mss-go-kr-site": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.mss.go.kr/site/smba/foffice/ex/statDB/stReportRoList.do",
        "params": {
          "gb": "1",
          "nodeId": "",
          "roCode": "",
          "pageSize": "10",
          "recordCountPerPage": "10",
          "searchGubun": "roCode"
        },
        "page_param": "pageIndex",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "reSeq",
          "url_field": "url",
          "date_field": "date",
          "title_field": "title",
          "listing_marker": "tbody"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
