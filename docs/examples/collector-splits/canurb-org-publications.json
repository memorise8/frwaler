{
  "version": 1,
  "sites": {
    "canurb-org-publications": {
      "strategy": "last_page_backward",
      "base_url": "https://canurb.org",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://canurb.org/publications/page/{page}/",
        "first_page_url": "https://canurb.org/publications/",
        "start_page": 1,
        "page_size": 98,
        "parser": {
          "type": "adapter",
          "url_field": "fetch_url",
          "key_field": "url",
          "title_field": "title",
          "listing_marker": "article[class*='publications']"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
