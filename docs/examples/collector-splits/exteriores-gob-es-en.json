{
  "version": 1,
  "sites": {
    "exteriores-gob-es-en": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://www.exteriores.gob.es/en/ServiciosAlCiudadano/Paginas/Publicaciones-oficiales.aspx",
        "page_param": "p",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "pdf_url",
          "key_field": "external_id",
          "date_field": "date",
          "listing_marker": "section.notasPrensa-Wrapper .no-results"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
