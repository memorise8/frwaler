{
  "version": 1,
  "sites": {
    "www6-slac-stanford-edu-news-and-events": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www6.slac.stanford.edu/news-and-events/news-center/archive",
        "params": {
          "created": "",
          "news_research_area": "All",
          "news_type": "1"
        },
        "page_param": "page",
        "start_page": 0,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "node_id",
          "date_field": "published_date",
          "title_field": "title",
          "listing_marker": ".c-view--display-news_archive"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
