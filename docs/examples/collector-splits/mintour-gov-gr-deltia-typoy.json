{
  "version": 1,
  "sites": {
    "mintour-gov-gr-deltia-typoy": {
      "strategy": "last_page_backward",
      "base_url": "https://mintour.gov.gr",
      "adapter": {
        "type": "crawler",
        "list_method": "_enumeration_items",
        "list_args": [
          "html",
          "url"
        ],
        "detail_method": "_enumeration_paper",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://mintour.gov.gr/category/deltia-typou/",
        "page_param": "paged",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "key_field": "external_id",
          "url_field": "url",
          "date_field": "listed_date",
          "title_field": "title",
          "listing_marker": ".elementor-posts-container"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
