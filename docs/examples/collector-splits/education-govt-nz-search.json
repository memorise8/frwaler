{
  "version": 1,
  "sites": {
    "education-govt-nz-search": {
      "strategy": "last_page_backward",
      "base_url": "https://www.education.govt.nz",
      "request_headers": {
        "x-algolia-application-id": "ZJYLA4J4R6"
      },
      "request_headers_env": {
        "x-algolia-api-key": "EDUCATION_GOVT_NZ_SEARCH_KEY"
      },
      "request_headers_hosts": [
        "zjyla4j4r6-dsn.algolia.net"
      ],
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://zjyla4j4r6-dsn.algolia.net/1/indexes/date_desc_live/query",
        "method": "POST",
        "idempotent": true,
        "body_type": "json",
        "params": {
          "analytics": false,
          "clickAnalytics": false,
          "facetFilters": [
            [
              "result.lvl1:Documents > Corporate publication"
            ]
          ],
          "facetingAfterDistinct": true,
          "filters": "status:true",
          "hitsPerPage": 20,
          "query": ""
        },
        "page_param": "page",
        "start_page": 0,
        "page_size": 20,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "objectID",
          "title_field": "title"
        },
        "total": {
          "type": "json",
          "path": "nbHits"
        }
      },
      "last_page": {
        "overlap_pages": 1
      },
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1
    }
  }
}
