{
  "version": 1,
  "sites": {
    "home-cern-news": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item"
        ]
      },
      "listing": {
        "url": "https://home.cern/feed/",
        "params": {
          "paged": 1
        },
        "page_param": "paged",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "key_field": "external_id",
          "date_field": "published_date",
          "listing_marker": "channel"
        }
      },
      "last_page": {
        "overlap_pages": 1
      }
    }
  }
}
