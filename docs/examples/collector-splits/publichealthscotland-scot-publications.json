{
  "version": 1,
  "sites": {
    "publichealthscotland-scot-publications": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "html"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ]
      },
      "listing": {
        "url": "https://www.publichealthscotland.scot/publications/",
        "params": {
          "q": "",
          "p": 1,
          "sort": ""
        },
        "page_param": "p",
        "start_page": 1,
        "parser": {
          "type": "adapter",
          "url_field": "url",
          "date_field": "listed_date",
          "listing_marker": "main"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": true
      }
    }
  }
}
