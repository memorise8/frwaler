{
  "version": 1,
  "sites": {
    "mindev-gov-gr-category": {
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "strategy": "last_page_backward",
      "verify_ssl": true,
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": [
          "json",
          "url"
        ],
        "detail_method": "_enumeration_detail",
        "detail_args": [
          "html",
          "item"
        ],
        "paper_method": "_enumeration_paper",
        "paper_args": [
          "item",
          "detail"
        ]
      },
      "listing": {
        "url": "https://www.mindev.gov.gr/wp-json/wp/v2/posts",
        "params": {
          "categories": "76",
          "per_page": "25",
          "page": 1,
          "_fields": "id,date,date_gmt,modified,modified_gmt,slug,link,title,excerpt,categories,tags"
        },
        "page_param": "page",
        "start_page": 1,
        "end_statuses": [
          {
            "status": 400,
            "json_code": "rest_post_invalid_page_number"
          }
        ],
        "total": {
          "type": "header",
          "name": "X-WP-Total"
        },
        "parser": {
          "type": "adapter",
          "url_field": "detail_api_url",
          "key_field": "external_id",
          "date_field": "published_date",
          "title_field": "title"
        }
      },
      "last_page": {
        "overlap_pages": 1,
        "check_unparameterized_first_page": false
      }
    }
  }
}