{
 "version": 1,
 "sites": {
  "pubshop-bmbwf-gv-at-indexphp": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://pubshop.bmbwf.gv.at",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://pubshop.bmbwf.gv.at/index.php",
    "params": {
     "article_id": "1",
     "type": "gesamtkatalog",
     "elementsPerRow": "20",
     "sort": "title"
    },
    "page_param": "offset",
    "start_page": 0,
    "page_mode": "offset",
    "page_size": 20,
    "parser": {
     "type": "adapter",
     "key_field": "pub_id",
     "url_field": "detail_url",
     "listing_marker": "div.pubList"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}