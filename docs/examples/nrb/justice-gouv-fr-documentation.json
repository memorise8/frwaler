{
 "version": 1,
 "sites": {
  "justice-gouv-fr-documentation": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.justice.gouv.fr",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html",
     "url"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.justice.gouv.fr/documentation/ressources?categories%5B%5D=399&categories%5B%5D=431&items_per_page=100",
    "page_param": "page",
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "url",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": "main"
    }
   },
   "last_page": {
    "overlap_pages": 1,
    "check_unparameterized_first_page": true
   }
  }
 }
}