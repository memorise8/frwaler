{
  "version": 1,
  "sites": {
    "bmlv-gv-at-wissen-forschung": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.bmlv.gv.at",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": ["raw"],
        "detail_method": "_enumeration_paper",
        "detail_args": ["item", "first_resp", "resp"],
        "second_step": {"use": "detail_page", "selector": "#content a[href*=\"beitrag.php?id=\"]",
                        "attr": "href", "required": false}
      },
      "listing": {
        "url": "https://www.bmlv.gv.at/wissen-forschung/publikationen/doktyp.php?id=14",
        "page_param": "page",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "pub_id", "url_field": "url",
                   "listing_marker": "#content"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
