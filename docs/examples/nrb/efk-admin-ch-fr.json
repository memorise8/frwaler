{
 "version": 1,
 "sites": {
  "efk-admin-ch-fr": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.efk.admin.ch",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "json"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "resp",
     "item",
     "first_resp"
    ],
    "second_step": {
     "use": "detail_page",
     "url_template": "https://www.efk.admin.ch/fr/wp-json/wp/v2/posts/{item:external_id}?_embed=wp:term",
     "required": false
    }
   },
   "listing": {
    "url": "https://www.efk.admin.ch/fr/wp-json/wp/v2/posts",
    "params": {
     "per_page": "20",
     "categories": "213",
     "_embed": "wp:term"
    },
    "page_param": "page",
    "start_page": 1,
    "end_statuses": [
     {
      "status": 400,
      "json_code": "rest_post_invalid_page_number"
     }
    ],
    "parser": {
     "type": "adapter",
     "key_field": "external_id",
     "url_field": "url",
     "title_field": "title",
     "date_field": "listed_date"
    },
    "total": {
     "type": "header",
     "name": "X-WP-Total"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}