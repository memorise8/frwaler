{
 "version": 1,
 "sites": {
  "home-treasury-gov-about": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://home.treasury.gov",
   "adapter": {
    "type": "crawler",
    "contract_version": 1,
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "item",
     "pdf_text"
    ],
    "pdf_text": {
     "args": [
      "-f",
      "1",
      "-l",
      "2"
     ],
     "timeout_s": 30,
     "min_bytes": 1
    }
   },
   "listing": {
    "url": "https://home.treasury.gov/about/budget-financial-reporting-planning-and-performance/good-accounting-obligation-in-government-act-gao-ig-act-reports",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "full_url",
     "url_field": "full_url",
     "title_field": "title",
     "listing_marker": "main"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}