{
 "version": 1,
 "sites": {
  "meteoswiss-admin-ch-services-and-publica": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.meteoswiss.admin.ch",
   "adapter": {
    "type": "crawler",
    "contract_version": 1,
    "list_method": "_enumeration_items",
    "list_args": [
     "json"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.meteoswiss.admin.ch/api/search/public-en/publications/results.json",
    "params": {
     "start": 0,
     "sort": "newest"
    },
    "page_param": "start",
    "start_page": 0,
    "page_mode": "offset",
    "page_size": 12,
    "parser": {
     "type": "adapter",
     "key_field": "path",
     "url_field": "_nrb_url",
     "date_field": "publicationDate",
     "title_field": "title"
    },
    "total": {
     "type": "json",
     "path": "response.numFound"
    }
   },
   "last_page": {
    "overlap_pages": 1,
    "check_unparameterized_first_page": true
   },
   "max_consecutive_contract_failures": 2000,
   "max_contract_failure_ratio": 0.99
  }
 }
}