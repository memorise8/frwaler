{
  "version": 1,
  "sites": {
    "bj-admin-ch-bj": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.bj.admin.ch",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": ["json"],
        "list_returns_paper": true
      },
      "listing": {
        "url": "https://d-nsbc-p.admin.ch/v1/search",
        "params": {
          "languages": "en",
          "newsKinds": ["CONTENT_HUB", "ONSB"],
          "publisherIDs": "29",
          "sort": "DESC",
          "start_date": "1990-01-01T00:00:00.000Z",
          "end_date": "2100-01-01T00:00:00.000Z",
          "offset": 0,
          "limit": 50
        },
        "page_param": "offset",
        "start_page": 0,
        "page_mode": "offset",
        "page_size": 50,
        "parser": {"type": "adapter", "key_field": "external_id", "url_field": "url",
                   "date_field": "listed_date", "title_field": "title"},
        "total": {"type": "json", "path": "pageResults"}
      },
      "last_page": {"overlap_pages": 1, "check_unparameterized_first_page": true}
    }
  }
}
