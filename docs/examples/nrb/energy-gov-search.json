{
 "version": 1,
 "sites": {
  "energy-gov-search": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.energy.gov",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "json"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.energy.gov/api/v1/search",
    "params": {
     "f[0]": "bundle_alias:Document"
    },
    "page_param": "page",
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "url",
     "url_field": "url",
     "title_field": "title"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}