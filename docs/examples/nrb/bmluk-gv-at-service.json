{
  "version": 1,
  "sites": {
    "bmluk-gv-at-service": {
      "strategy": "last_page_backward",
      "request_interval_s": 1.5,
      "respect_robots": true,
      "retries": 1,
      "verify_ssl": true,
      "base_url": "https://www.bmluk.gv.at",
      "adapter": {
        "type": "crawler",
        "contract_version": 1,
        "list_method": "_enumeration_items",
        "list_args": ["html"],
        "list_returns_paper": true
      },
      "listing": {
        "url": "https://www.bmluk.gv.at/service/zahlen-fakten-neu/statistik-agrarmarkt.html",
        "page_param": "page",
        "start_page": 1,
        "parser": {"type": "adapter", "key_field": "url", "url_field": "url", "title_field": "title",
                   "listing_marker": "div.richtext_output"}
      },
      "last_page": {"overlap_pages": 1}
    }
  }
}
