{
 "version": 1,
 "sites": {
  "sib-swiss-training": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.sib.swiss",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "list_returns_paper": true
   },
   "listing": {
    "url": "https://www.sib.swiss/training/training-materials",
    "page_param": "page",
    "start_page": 0,
    "parser": {
     "type": "adapter",
     "key_field": "external_id",
     "url_field": "url",
     "title_field": "title",
     "date_field": "published_date",
     "listing_marker": "main"
    }
   },
   "last_page": {
    "overlap_pages": 1,
    "check_unparameterized_first_page": true
   }
  }
 }
}