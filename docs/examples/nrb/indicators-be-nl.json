{
 "version": 1,
 "sites": {
  "indicators-be-nl": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://indicators.be",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://indicators.be/nl/t/SDG/",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "url",
     "url_field": "url",
     "listing_marker": "body"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}