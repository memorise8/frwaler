{
 "version": 1,
 "sites": {
  "mfat-govt-nz-en": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.mfat.govt.nz",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "html"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "html",
     "item"
    ]
   },
   "listing": {
    "url": "https://www.mfat.govt.nz/en/about-us/mfat-annual-reports",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "slug",
     "url_field": "url",
     "title_field": "title",
     "listing_marker": "main"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}