{
 "version": 1,
 "sites": {
  "seco-admin-ch-seco": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://www.seco.admin.ch",
   "adapter": {
    "type": "crawler",
    "contract_version": 1,
    "list_method": "_enumeration_items",
    "list_args": [
     "json"
    ],
    "list_returns_paper": true
   },
   "listing": {
    "url": "https://d-nsbc-p.admin.ch/v1/search",
    "params": {
     "languages": "en",
     "newsKinds": [
      "CONTENT_HUB",
      "ONSB"
     ],
     "publisherIDs": "60",
     "start_date": "2023-01-01T00:00:00.000Z",
     "end_date": "2030-12-31T23:59:59.999Z",
     "sort": "DESC",
     "limit": 100,
     "offset": 0
    },
    "page_param": "offset",
    "start_page": 0,
    "page_mode": "offset",
    "page_size": 100,
    "parser": {
     "type": "adapter",
     "key_field": "external_id",
     "url_field": "url",
     "date_field": "posted_date",
     "title_field": "title"
    },
    "total": {
     "type": "json",
     "path": "pageResults"
    }
   },
   "last_page": {
    "overlap_pages": 1,
    "check_unparameterized_first_page": true
   }
  }
 }
}