{
 "version": 1,
 "sites": {
  "provenienzforschung-gv-at-empfehlungen-des-bei": {
   "strategy": "last_page_backward",
   "request_interval_s": 1.5,
   "respect_robots": true,
   "retries": 1,
   "verify_ssl": true,
   "base_url": "https://provenienzforschung.gv.at",
   "adapter": {
    "type": "crawler",
    "list_method": "_enumeration_items",
    "list_args": [
     "raw"
    ],
    "detail_method": "_enumeration_paper",
    "detail_args": [
     "raw",
     "item"
    ]
   },
   "listing": {
    "url": "https://provenienzforschung.gv.at/empfehlungen-des-beirats/beschluesse/beschluesse-alphabetisch/",
    "page_param": "page",
    "start_page": 1,
    "parser": {
     "type": "adapter",
     "key_field": "external_id",
     "url_field": "url",
     "title_field": "th_text",
     "listing_marker": "table.downloads"
    }
   },
   "last_page": {
    "overlap_pages": 1
   }
  }
 }
}